ase de jeu'}</span><small>PHASE ${phase} · ${e.home===false?'VISITEUR':'DOMICILE'} EN POSSESSION</small>`}}
function toolbar(){const wrap=document.querySelector('.prm10-wrap')||document.querySelector('.match-console');if(!wrap||document.getElementById('prm13-strip'))return;const bar=document.createElement('div');bar.id='prm13-strip';bar.className='prm13-strip';bar.innerHTML='<strong>MATCH TV</strong><button data-c="broadcast">AUTO TV</button><button data-c="follow">SUIVI</button><button data-c="wide">TACTIQUE</button><button data-c="touch">RAS DU SOL</button><i></i><span>DETAIL</span><button data-q="cinema">HAUT</button><button data-q="eco">ECO</button><button data-full="1">⛶</button>';wrap.prepend(bar);const sync=()=>[...bar.querySelectorAll('button')].forEach(b=>b.classList.toggle('on',(b.dataset.c&&b.dataset.c===state.prm13Camera)||(b.dataset.q&&b.dataset.q===state.prm13Quality)));bar.onclick=async ev=>{const b=ev.target.closest('button');if(!b)return;if(b.dataset.c)state.prm13Camera=b.dataset.c;if(b.dataset.q)state.prm13Quality=b.dataset.q;if(b.dataset.full){try{if(!document.fullscreenElement)await wrap.requestFullscreen?.();else await document.exitFullscreen?.()}catch(_){}}sync()};sync()}
const obs=new MutationObserver(()=>{enhance();toolbar()});obs.observe(document.documentElement,{subtree:true,childList:true});setInterval(()=>{enhance();toolbar()},450);enhance();toolbar();
})();
