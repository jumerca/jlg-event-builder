function benchArea(ctx,w,h){ctx.fillStyle='rgba(18,23,20,.88)';ctx.fillRect(w*.05,h*.215,w*.17,8);ctx.fillRect(w*.78,h*.215,w*.17,8);for(let k=0;k<6;k++){ctx.fillStyle=k%2?'#bcb9ae':'#333b35';ctx.fillRect(w*.065+k*9,h*.207,3,5);ctx.fillRect(w*.795+k*9,h*.207,3,5)}}
function poseFor(type,att,i,p){const t=norm(type),ci=carrierIndex({type});if(t.includes('MELEE'))return i<8?'scrum':i===8?'ready':'guard';if(t.includes('TOUCHE')){if(i===3&&p>.30&&p<.76)return'jump';if((i===2||i===4)&&p>.28&&p<.78)return'lift';return'ready'}if(t.includes('RUCK')||t.includes('TURNOVER')){if(i<2&&p>.35)return'ruck';if((i===2||i===3)&&p>.25)return'clean';if(i===8&&att&&p>.78)return'pass';return'arrive'}if(t.includes('PERCUSSION')){if(att&&i===11)return p>.66?'ground':'carry';if(!att&&i===12)return p>.56?'tackle':'run';return'run'}if(t.includes('PASSE')){if(att&&i>8)return'pass';return'run'}if(t.includes('PIED')||t.includes('DROP'))return att&&i===9?'kick':'chase';if(t.includes('ESSAI'))return att&&i===13&&p>.76?'dive':'run';return'run'}
function skin(p){const v=hash(p?.id||p?.name||'p')%5;return['#e6b68a','#c98f65','#a86f4e','#825238','#efc59f'][v]}
function drawPlayer(ctx,p,n,home,pt,type,att,i,ts,pct,col){const pr=profile(p),s=pt.s*pr.h,b=pr.w,pose=poseFor(type,att,i,pct),run=['run','chase','carry','arrive'].includes(pose),cy=ts*.015+i*1.7+(home?0:1),step=run?Math.sin(cy)*4.4:0,bob=run?Math.abs(Math.sin(cy))*1.05:0;let lean=pose==='scrum'?.79:pose==='ruck'?1.12:pose==='clean'?.82:pose==='tackle'?.95:pose==='ground'?1.47:pose==='dive'?1.38:pose==='kick'?.20:pose==='lift'?.04:.07;let x=pt.x,y=pt.y+bob*s;ctx.save();ctx.fillStyle='rgba(0,0,0,.34)';ctx.beginPath();ctx.ellipse(x+2*s,y+5*s,6.7*b*s,2.55*s,0,0,Math.PI*2);ctx.fill();ctx.translate(x,y);ctx.rotate((home?1:-1)*lean);ctx.lineCap='round';
 const sk=skin(p);ctx.strokeStyle=col[1];ctx.lineWidth=2.35*s;ctx.beginPath();ctx.moveTo(-2.2*b*s,-.8*s);ctx.lineTo((-2.4-step)*b*s,8.8*s);ctx.moveTo(2.2*b*s,-.8*s);ctx.lineTo((2.4+step)*b*s,8.8*s);ctx.stroke();ctx.strokeStyle=col[0];ctx.lineWidth=1.5*s;ctx.beginPath();ctx.moveTo((-2.4-step)*b*s,6.1*s);ctx.lineTo((-2.4-step)*b*s,9.2*s);ctx.moveTo((2.4+step)*b*s,6.1*s);ctx.lineTo((2.4+step)*b*s,9.2*s);ctx.stroke();
 let grad=ctx.createLinearGradient(-6*s,-14*s,6*s,-2*s);grad.addColorStop(0,col[0]);grad.addColorStop(1,'rgba(15,15,15,.35)');ctx.fillStyle=grad;ctx.beginPath();ctx.moveTo(-5.3*b*s,-13*s);ctx.quadraticCurveTo(0,-16*s,5.3*b*s,-13*s);ctx.lineTo(4.4*b*s,-3*s);ctx.lineTo(-4.4*b*s,-3*s);ctx.closePath();ctx.fill();ctx.fillStyle=col[1];ctx.fillRect(-4.6*b*s,-3*s,9.2*b*s,4.4*s);
 const arm=run?Math.sin(cy+Math.PI)*3.7:pose==='pass'?4.5:pose==='tackle'?5.5:pose==='lift'?-5:1.2;ctx.strokeStyle=sk;ctx.lineWidth=1.95*s;ctx.beginPath();ctx.moveTo(-4.5*b*s,-11*s);ctx.lineTo((-7-arm)*b*s,-4*s);ctx.moveTo(4.5*b*s,-11*s);ctx.lineTo((7+arm)*b*s,-4*s);ctx.stroke();ctx.fillStyle=sk;ctx.beginPath();ctx.arc(0,-16.1*s,3.1*s,0,Math.PI*2);ctx.fill();ctx.fillStyle='rgba(25,19,15,.75)';ctx.fillRect(-2.5*s,-19*s,5*s,1.4*s);
 if(pose==='carry'){ctx.fillStyle='#efe4c7';ctx.strokeStyle='#57482f';ctx.lineWidth=.7;ctx.beginPath();ctx.ellipse((home?5:-5)*s,-7*s,3.7*s,1.9*s,.15,0,Math.PI*2);ctx.fill();ctx.stroke()}
 if(state.prm13Quality==='cinema'&&s>.48){ctx.fillStyle='#fff';ctx.font=`700 ${Math.max(4,4.8*s)}px Arial`;ctx.textAlign='center';ctx.fillText(String(n),0,-7*s)}ctx.restore()}
function playerPos(home,i,e,p,w,h){const q=actionShape(home,i,e,p);return proj(q[0],q[1],w,h)}
function ballWorld(e,p){const t=norm(e?.type),home=e?.home!==false,d=dir(home),bx=e?.x??50,by=e?.y??50;let x=bx,y=by,z=1.3;if(t.includes('PASSE')){const chain=[8,9,11,12,13,10],parts=chain.length-1,seg=Math.min(parts-1,Math.floor(p*parts)),u=(p*parts)-seg;let a=lineFormation(home,chain[seg],e),b=lineFormation(home,chain[seg+1],e);x=lerp(a[0],b[0],smooth(u));y=lerp(a[1],b[1],smooth(u));z=4+Math.sin(u*Math.PI)*4}
 else if(t.includes('PIED')||t.includes('DROP')){x=bx+d*p*46;y=by+(Math.sin(p*Math.PI*1.4)*10);z=3+Math.sin(p*Math.PI)*24}
 else if(t.includes('TOUCHE')){const edge=by<50?8:92,sg=by<50?1:-1;x=bx+d*(p<.7?p*1.2:(p-.7)*14);y=lerp(edge,edge+sg*19,Math.min(p/.62,1));z=3+Math.sin(Math.min(p/.66,1)*Math.PI)*15}
 else if(t.includes('RUCK')||t.includes('TURNOVER')){x=bx-d*(p>.82?(p-.82)*24:0);y=by+2.1;z=p>.82?2.8:1.0}
 else if(t.includes('MELEE')){x=bx-d*(p>.85?(p-.85)*25:0);y=by+1.5;z=1.1}
 else if(t.includes('PERCUSSION')){x=bx-d*(10*(1-smooth(Math.min(p/.50,1))));y=by;z=p>.68?1.0:5.1}
 else if(t.inclu