function cameraTarget(e,p){const t=norm(e?.type),ne=nextEvent();let x=e?.x??50,y=e?.y??50,z=1.02;const look=(state.prm13Camera==='broadcast')?.16:.05;if(ne){x=lerp(x,ne.x??x,look);y=lerp(y,ne.y??y,look)}if(t.includes('RUCK')||t.includes('PERCUSSION'))z=1.18;if(t.includes('MELEE'))z=1.15;if(t.includes('TOUCHE')){y=(e?.y??50)<50?23:77;z=1.12}if(t.includes('PIED'))z=.92;if(t.includes('ESSAI'))z=1.20;if(state.prm13Camera==='wide')z=.83;if(state.prm13Camera==='touch')z=1.24;if(state.prm13Camera==='follow')z=1.27;return{x,y,z}}
