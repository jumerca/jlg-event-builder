des('ESSAI')){x=bx-d*(11*(1-smooth(Math.min(p/.76,1))));y=by;z=p>.82?1:5}
 return{x,y,z}}
function drawBall(ctx,e,p,w,h,ts){const q=ballWorld(e,p),pt=proj(q.x,q.y,w,h),s=pt.s;ctx.save();ctx.translate(pt.x,pt.y-q.z*s*.68);ctx.rotate(ts*.013);ctx.fillStyle='#eee4c7';ctx.strokeStyle='#4c3d2a';ctx.lineWidth=.8;ctx.beginPath();ctx.ellipse(0,0,5.2*s,2.55*s,.28,0,Math.PI*2);ctx.fill();ctx.stroke();ctx.restore()}
function drawOfficials(ctx,e,p,w,h,ts){const bx=e?.x??50,by=e?.y??50;[[bx-2,clamp(by+18,8,92)],[bx+10,clamp(by-24,7,93)]].forEach((a,k)=>{const q=proj(a[0],a[1],w,h),s=q.s;ctx.save();ctx.translate(q.x,q.y);ctx.fillStyle='rgba(0,0,0,.3)';ctx.beginPath();ctx.ellipse(0,4*s,4*s,1.6*s,0,0,Math.PI*2);ctx.fill();ctx.strokeStyle='#111';ctx.lineWidth=1.5*s;ctx.beginPath();ctx.moveTo(-1*s,-1*s);ctx.lineTo(-2.5*s,6*s);ctx.moveTo(1*s,-1*s);ctx.lineTo(2.5*s,6*s);ctx.stroke();ctx.fillStyle='#42b7d8';ctx.fillRect(-3*s,-8*s,6*s,7*s);ctx.fillStyle='#d6a47e';ctx.beginPath();ctx.arc(0,-10*s,2*s,0,Math.PI*2);ctx.fill();ctx.restore()})}
function contactFX(ctx,e,p,w,h){const t=norm(e?.type),q=proj(e?.x??50,e?.y??50,w,h);if(t.includes('PERCUSSION')&&p>.40&&p<.67){let a=1-Math.abs(p-.535)/.135;ctx.strokeStyle=`rgba(255,235,185,${.34*a})`;ctx.lineWidth=1.5;for(let k=0;k<7;k++){let ang=k*Math.PI*2/7,r=8+14*a;ctx.beginPath();ctx.moveTo(q.x+Math.cos(ang)*4,q.y+Math.sin(ang)*2);ctx.lineTo(q.x+Math.cos(ang)*r,q.y+Math.sin(ang)*r*.45);ctx.stroke()}}if((t.includes('RUCK')||t.includes('MELEE'))&&p>.28){ctx.fillStyle='rgba(92,63,37,.09)';ctx.beginPath();ctx.ellipse(q.x,q.y,24*q.s,7*q.s,0,0,Math.PI*2);ctx.fill()}}
function drawPhaseLines(ctx,e,p,w,h){if(state.prm13Quality!=='cinema')return;const t=norm(e?.type),home=e?.home!==false,d=dir(home),bx=e?.x??50,by=e?.y??50;if(t.includes('PASSE')){ctx.save();ctx.strokeStyle='rgba(240,211,123,.18)';ctx.lineWidth=1;ctx.setLineDash([4,7]);const a=proj(bx-d*8,8,w,h),b=proj(bx-d*8,92,w,h);ctx.beginPath();ctx.moveTo(a.x,a.y);ctx.lineTo(b.x,b.y);ctx.stroke();ctx.restore()}if(t.includes('RUCK')){let a=proj(bx+d*2,5,w,h),b=proj(bx+d*2,95,w,h);line(ctx,a,b,'rgba(255,255,255,.13)',1,[3,8])}}
function render(ts){const inf=canvasInfo();if(!inf){raf=requestAnimationFrame(render);return}const {ctx,w,h}=inf,m=state.match,e=currentEvent();if(m&&m.index!==lastIndex){lastIndex=m.index;phaseStart=performance.now()}const p=progress(e);cameraStep(e,p);stadium(ctx,w,h,m);drawPhaseLines(ctx,e,p,w,h);if(m&&typeof club==='function'){const hc=club(m.homeId),ac=club(m.awayId),hl=fifteen(hc),al=fifteen(ac),actors=[];for(let i=0;i<15;i++){actors.push({home:true,i,p:hl[i],pt:playerPos(true,i,e,p,w,h),att:e?.home===true,col:colors(hc,true)});actors.push({home:false,i,p:al[i],pt:playerPos(false,i,e,p,w,h),att:e?.home===false,col:colors(ac,false)})}actors.sort((a,b)=>a.pt.y-b.pt.y);contactFX(ctx,e,p,w,h);drawOfficials(ctx,e,p,w,h,ts);actors.forEach(a=>drawPlayer(ctx,a.p,a.i+1,a.home,a.pt,e?.type,a.att,a.i,ts,p,a.col));drawBall(ctx,e,p,w,h,ts);let vg=ctx.createRadialGradient(w/2,h*.58,h*.23,w/2,h*.58,h*.78);vg.addColorStop(.6,'rgba(0,0,0,0)');vg.addColorStop(1,'rgba(0,0,0,.26)');ctx.fillStyle=vg;ctx.fillRect(0,0,w,h)}raf=requestAnimationFrame(render)}
function purgeOld(stage){[...stage.querySelectorAll('canvas[id^="prm"]')].forEach(c=>{if(c.id!=='prm13-canvas')c.remove()});['#prm12-strip','.prm12-live','.prm12-phase','#prm11-strip','.prm11-live','.prm11-phase'].forEach(sel=>stage.closest('.prm10-wrap')?.querySelectorAll(sel).forEach(n=>n.remove()))}
function enhance(){const wrap=document.querySelector('.prm10-wrap')||document.querySelector('.match-console')||document.querySelector('.match-shell');if(!wrap)return;const stage=wrap.querySelector('.prm10-stage')||wrap.querySelector('.stadium-shell')||wrap.querySelector('.match-stage');if(!stage)return;purgeOld(stage);let c=document.getElementById('prm13-canvas');if(!c){c=document.createElement('canvas');c.id='prm13-canvas';c.setAttribute('aria-label','Rugby Legacy Broadcast Engine 1.3');stage.prepend(c);let live=document.createElement('div');live.className='prm13-live';live.innerHTML='<b>RUGBY LEGACY</b><span>BROADCAST 1.3</span>';stage.appendChild(live);let ph=document.createElement('div');ph.className='prm13-phase';ph.id='prm13-phase';stage.appendChild(ph);if(!raf)raf=requestAnimationFrame(render)}const e=currentEvent(),ph=document.getElementById('prm13-phase');if(ph&&e){const p=progress(e),m=state.match,phase=(m?.index||0);ph.innerHTML=`<b>${stageName(e.type,p)}</b><span>${e.text||e.type||'Ph