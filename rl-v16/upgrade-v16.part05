function seedWorldNews(){if(state.save.world.news.length)return;news16('launch','Le monde Rugby Legacy est actif',`TOP 14, PRO D2 et Nationale évoluent désormais simultanément pendant ta carrière.`,2);news16('regulation','Règlement 2026-27 intégré',`Le moteur suit la moyenne JIFF, la liste de référence non-JIFF, le salary cap TOP 14 et les Access Matches.`,2)}
const clubBase16=clubView;clubView=function(){initWorld();seedWorldNews();const s=state.save.world.section||'clubhouse';if(s==='clubhouse')return worldNav('clubhouse')+clubBase16();return worldView16(s)};
const squadBase16=squadView;squadView=function(){initWorld();const c=user16(),r=state.save.world.reg,avg=r.jiffSheets.length?jiffAverage().toFixed(2):'—',non=c.players.filter(p=>!isJiff(p)).length;return `<div class="world16-squad-reg"><div><span>JIFF moyen</span><b>${avg}</b><small>cible 16</small></div><div><span>Non-JIFF</span><b>${non}</b><small>${r.nonJiffRef.length}/13 inscrits</small></div><div><span>Salary cap</span><b>${c.comp==='top14'?euro(salaryCap16()):'Interne'}</b><small>${seasonKey()}</small></div><button onclick="state.tab='club';setWorldSection('regulations')">Règlement</button></div>`+squadBase16()};
const dashBase16=dashboardView;dashboardView=function(){initWorld();seedWorldNews();const base=dashBase16(),news=state.save.world.news.slice(0,4),leaders=['top14','prod2','nationale'].map(k=>{const r=table16(k)[0],c=club16(r?.clubId);return c?`${DB.comps[k]?.name||k} : ${c.short}`:''}).filter(Boolean);return base+`<div class="world16-dashboard"><div class="section-title"><h2>Le monde autour de toi</h2><p>${leaders.map(X).join(' · ')}</p></div><div class="world16-dash-news">${news.map(n=>`<button onclick="state.tab='club';setWorldSection('news')"><span>${X(n.type)}</span><b>${X(n.title)}</b><small>${X(n.body)}</small></button>`).join('')}</div></div>`};
const openBase16=openCurrentMatch;openCurrentMatch=function(){initWorld();const msg=matchRegCheck();if(msg&&msg.includes('non inscrit'))return toast(msg);if(msg)toast(msg);openBase16()};
const commitBase16=commitMatch;commitMatch=function(){let snap=null;if(state.match){const m=state.match,uc=user16(),homeUser=m.homeId===uc.id;snap={homeId:m.homeId,awayId:m.awayId,hs:m.hs||0,as:m.as||0,events:[...(m.events||[])],homeLineup:homeUser?[...(state.save.lineup||[])]:null,awayLineup:homeUser?null:[...(state.save.lineup||[])],homeBench:homeUser?[...(state.save.bench||[])]:null,awayBench:homeUser?null:[...(state.save.bench||[])]}}commitBase16();if(state.save){initWorld();if(snap)recordMatchStats(snap);worldWeekly();saveLocal();render()}};
const continueBase16=continueCareer;continueCareer=function(){continueBase16();if(state.save){initWorld();seedWorldNews();worldWeekly();saveLocal();render()}};
const startBase16=startClub;startClub=function(id){startBase16(id);if(state.save){initWorld();seedWorldNews();saveLocal();render()}};
const customBase16=buildCustomClub;buildCustomClub=function(){customBase16();if(state.save){initWorld();seedWorldNews();saveLocal();render()}};
window.advanceSeason15=advanceSeason16;
Object.assign(window,{setWorldSection,registerNonJiff,advanceSeason16});
if(state.save){initWorld();seedWorldNews();saveLocal()}
})();
