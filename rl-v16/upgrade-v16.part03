function simKnockout(aId,bId,label){const a=club16(aId),b=club16(bId);if(!a||!b)return aId||bId;const [as,bs]=scorePair(a,b,`${seasonKey()}-${label}-${aId}-${bId}`);const winner=as===bs?((H(label+aId+bId)%2)?aId:bId):(as>bs?aId:bId);news16('finals',label,`${a.name} ${as} - ${bs} ${b.name}. ${club16(winner).name} se qualifie.`,2);return winner}
function postseasonFor(comp){const ids=table16(comp).map(r=>r.clubId);if(comp==='top14'&&ids.length>=6){const q1=simKnockout(ids[3],ids[4],'Barrage TOP 14 · 4e/5e'),q2=simKnockout(ids[2],ids[5],'Barrage TOP 14 · 3e/6e'),s1=simKnockout(ids[0],q1,'Demi-finale TOP 14'),s2=simKnockout(ids[1],q2,'Demi-finale TOP 14'),champ=simKnockout(s1,s2,'Finale TOP 14');return{champion:champ,finalist:champ===s1?s2:s1,regular:ids}}
 if(comp==='prod2'&&ids.length>=6){const q1=simKnockout(ids[3],ids[4],'Barrage PRO D2 · 4e/5e'),q2=simKnockout(ids[2],ids[5],'Barrage PRO D2 · 3e/6e'),s1=simKnockout(ids[0],q1,'Demi-finale PRO D2'),s2=simKnockout(ids[1],q2,'Demi-finale PRO D2'),champ=simKnockout(s1,s2,'Finale PRO D2');return{champion:champ,finalist:champ===s1?s2:s1,regular:ids}}
 if(comp==='nationale'&&ids.length>=2){const champ=simKnockout(ids[0],ids[1],'Finale Nationale');return{champion:champ,finalist:champ===ids[0]?ids[1]:ids[0],regular:ids}}return{champion:ids[0],finalist:ids[1],regular:ids}}
function swapComp(aId,bId,aComp,bComp){const a=club16(aId),b=club16(bId);if(!a||!b)return;a.comp=aComp;b.comp=bComp;const promoted=a.comp===aComp?a:null;if(aComp==='top14'||aComp==='prod2'){a.budget=Math.round((a.budget||2000000)*1.18);a.cash=(a.cash||0)+250000}b.budget=Math.round((b.budget||2000000)*.88)}
function archiveSeason(pre){const w=state.save.world;const snapshot={season:seasonKey(),date:state.save.date||'',top14:pre.top,prod2:pre.d2,nationale:pre.nat,userClub:state.save.clubId,userComp:user16()?.comp,jiffAverage:+jiffAverage().toFixed(2),topScorers:allPlayers().map(p=>({id:p.id,name:`${p.first} ${p.last}`,tries:p.stats?.seasons?.[seasonKey()]?.tries||0,points:p.stats?.seasons?.[seasonKey()]?.points||0})).sort((a,b)=>b.tries-a.tries).slice(0,10)};w.archive.unshift(snapshot);w.archive=w.archive.slice(0,20);w.records.champions.top14.unshift({season:snapshot.season,clubId:pre.top.champion});w.records.champions.prod2.unshift({season:snapshot.season,clubId:pre.d2.champion});w.records.champions.nationale.unshift({season:snapshot.season,clubId:pre.nat.champion});news16('title','Champion de France',`${club16(pre.top.champion)?.name||'—'} remporte le TOP 14 ${snapshot.season}.`,3)}
function applyRealisticMovement(pre){const topReg=pre.top.regular,d2Reg=pre.d2.regular,natReg=pre.nat.regular;if(!topReg.length||!d2Reg.length||!natReg.length)return;
 const top14th=topReg[topReg.length-1],top13=topReg[topReg.length-2],d2Last=d2Reg[d2Reg.length-1],d2Fifteenth=d2Reg[d2Reg.length-2];
 // Undo the simplified direct swaps made by v1.5 if they used different regular-season leaders.
 const oldD2Leader=d2Reg[0],oldNatLeader=natReg[0];if(oldD2Leader!==pre.d2.champion){club16(oldD2Leader).comp='prod2';club16(pre.d2.champion).comp='top14'}if(oldNatLeader!==pre.nat.champion){club16(oldNatLeader).comp='nationale';club16(pre.nat.champion).comp='prod2'}
 club16(top14th).comp='prod2';club16(d2Last).comp='nationale';
 const topAccessWinner=simKnockout(top13,pre.d2.finalist,'Access Match TOP 14');if(topAccessWinner===pre.d2.finalist){club16(top13).comp='prod2';club16(pre.d2.finalist).comp='top14';news16('promotion','Montée via Access Match',`${club16(pre.d2.finalist).name} accède au TOP 14.`,3)}else{club16(top13).comp='top14';club16(pre.d2.finalist).comp='prod2'}
 const d2AccessWinner=simKnockout(d2Fifteenth,pre.nat.finalist,'Access Match PRO D2');if(d2AccessWinner===pre.nat.finalist){club16(d2Fifteenth).comp='nationale';club16(pre.nat.finalist).comp='prod2';news16('promotion','Montée via Access Match',`${club16(pre.nat.finalist).name} accède à la PRO D2.`,3)}else{club16(d2Fifteenth).comp='prod2';club16(pre.nat.finalist).comp='nationale'}
}
function resetWorldForSeason(){const w=state.save.world;w.comps={top14:makeWorldCompetition('top14'),prod2:makeWorldCompetition('prod2'),nationale:makeWorldCompetition('nationale')};w.processedRounds=[];w.reg.lastSeasonAverage=w.reg.jiffSheets.length?jiffAverage():null;w.reg.jiffSheets=[];w.reg.warnings=[];const uc=user16(),non=uc.players.filter(p=>!isJiff(p)).sort((a,b)=>(b.ca||0)-(a.ca||0));w.reg.nonJiffRef=non.slice(0,13).map(p=>p.id);if(DB?.comps?.top14)DB.comps.top14.salaryCap=salaryCap16();}
const advanceSeasonBase16=window.advanceSeason15;
function advanceSeason16(){initWorld();const max=Math.max(0,...(state.save.schedule||[]).map(x=>x.round||0));if(state.save.round<=max)return toast('La saison n’est pas terminée.');const pre={top:postseasonFor('top14'),d2:postseasonFor('prod2'),nat:postseasonFor('nationale')};archiveSeason(pre);const beforeComp=user16().comp;advanceSeasonBase16();applyRealisticMovement(pre);const uc=user16();state.save.competition=uc.comp;if(typeof generateSchedule==='function')state.save.schedule=generateSchedule(uc.comp,state.save.clubs);if(typeof blankTable==='function')state.save.table=blankTable(uc.comp,state.save.clubs);state.save.round=1;resetWorldForSeason();state.save.world.section='clubhouse';state.save.inbox.unshift({title:'Saison '+seasonKey(),body:`Nouvelle saison en ${DB.comps[uc.comp]?.name||uc.comp}. Les calendriers et règlements ont été réinitialisés.`,type:'board'});if(beforeComp!==uc.comp)news16('promotion','Changement de division',`${uc.name} évoluera désormais en ${DB.comps[uc.comp]?.name||uc.comp}.`,3);saveLocal();render();toast('Nouvelle saison complète lancée')}
