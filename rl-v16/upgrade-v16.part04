function worldNav(active){const tabs=[['clubhouse','Club House'],['news','Actualités'],['competitions','Compétitions'],['stats','Statistiques'],['regulations','Règlement'],['clubs','Clubs IA']];return `<div class="world16-nav">${tabs.map(([k,l])=>`<button class="${active===k?'active':''}" onclick="setWorldSection('${k}')">${l}</button>`).join('')}</div>`}
function setWorldSection(s){initWorld();state.save.world.section=s;saveLocal();render()}
function newsView16(){const n=state.save.world.news;return `${worldNav('news')}<div class="world16-head"><div><span>MONDE DU RUGBY</span><h2>Fil d’actualité</h2><p>Résultats, transferts, entraîneurs, formations et mouvements des trois divisions.</p></div><b>${n.length}</b></div><div class="world16-news">${n.length?n.slice(0,80).map(x=>`<article class="imp${x.importance||1}"><div><span>${X((x.type||'info').toUpperCase())}</span><small>J${x.round} · ${X(x.season)}</small></div><h3>${X(x.title)}</h3><p>${X(x.body)}</p></article>`).join(''):'<div class="world16-empty">Les premières nouvelles apparaîtront au fil des journées.</div>'}</div>`}
function compCard16(comp){const t=table16(comp),name=DB.comps[comp]?.name||comp;return `<section class="world16-comp"><div class="world16-comp-head"><div><span>${name}</span><h3>Classement</h3></div><b>${t.length} clubs</b></div><div class="world16-table"><table><thead><tr><th>#</th><th>Club</th><th>J</th><th>G</th><th>N</th><th>P</th><th>+/-</th><th>Pts</th></tr></thead><tbody>${t.map((r,i)=>{const c=club16(r.clubId);return `<tr class="${c?.id===state.save.clubId?'mine':''}"><td>${i+1}</td><td><b>${X(c?.short||'—')}</b><small>${X(c?.name||'')}</small></td><td>${r.p??((r.w||0)+(r.d||0)+(r.l||0))}</td><td>${r.w||0}</td><td>${r.d||0}</td><td>${r.l||0}</td><td>${(r.pf||0)-(r.pa||0)>=0?'+':''}${(r.pf||0)-(r.pa||0)}</td><td><strong>${r.pts||0}</strong></td></tr>`}).join('')}</tbody></table></div></section>`}
function competitionsView16(){const ar=state.save.world.archive;return `${worldNav('competitions')}<div class="world16-head"><div><span>SAISON ${seasonKey()}</span><h2>Compétitions nationales</h2><p>TOP 14, PRO D2 et Nationale suivis simultanément.</p></div></div><div class="world16-comp-grid">${['top14','prod2','nationale'].map(compCard16).join('')}</div><div class="world16-section"><h3>Palmarès récent</h3>${ar.length?`<div class="world16-archive">${ar.slice(0,8).map(s=>`<div><b>${X(s.season)}</b><span>TOP 14 : ${X(club16(s.top14.champion)?.name||'—')}</span><span>PRO D2 : ${X(club16(s.prod2.champion)?.name||'—')}</span><span>Nationale : ${X(club16(s.nationale.champion)?.name||'—')}</span></div>`).join('')}</div>`:'<div class="world16-empty">Le palmarès se remplira à la fin de la première saison.</div>'}</div>`}
function statVal(p,k){return p.stats?.seasons?.[seasonKey()]?.[k]||0}
function statsView16(){const players=allPlayers();const byTries=[...players].sort((a,b)=>statVal(b,'tries')-statVal(a,'tries')).slice(0,20),byPts=[...players].sort((a,b)=>statVal(b,'points')-statVal(a,'points')).slice(0,20),byApps=[...players].sort((a,b)=>statVal(b,'mins')-statVal(a,'mins')).slice(0,20);const renderList=(arr,key,label)=>`<div class="world16-leaders"><h3>${label}</h3>${arr.map((p,i)=>{const c=state.save.clubs.find(x=>x.players.some(y=>y.id===p.id));return `<div><span>${i+1}</span><p><b>${X(p.first)} ${X(p.last)}</b><small>${X(c?.short||'Libre')} · ${p.pos}</small></p><strong>${statVal(p,key)}</strong></div>`}).join('')}</div>`;return `${worldNav('stats')}<div class="world16-head"><div><span>DATA CENTRE</span><h2>Statistiques de carrière</h2><p>Les statistiques sont conservées saison après saison pour chaque joueur.</p></div></div><div class="world16-stat-grid">${renderList(byTries,'tries','Meilleurs marqueurs')}${renderList(byPts,'points','Meilleurs réalisateurs')}${renderList(byApps,'mins','Temps de jeu')}</div><div class="world16-section"><h3>Ton effectif</h3><div class="world16-table"><table><thead><tr><th>Joueur</th><th>MJ</th><th>Tit.</th><th>Min</th><th>Essais</th><th>Points</th><th>Plaquages</th><th>Mètres</th><th>Carrière MJ</th></tr></thead><tbody>${[...user16().players].sort((a,b)=>statVal(b,'apps')-statVal(a,'apps')).map(p=>`<tr><td><b>${X(p.first)} ${X(p.last)}</b><small>${p.pos}</small></td><td>${statVal(p,'apps')}</td><td>${statVal(p,'starts')}</td><td>${statVal(p,'mins')}</td><td>${statVal(p,'tries')}</td><td>${statVal(p,'points')}</td><td>${statVal(p,'tackles')}</td><td>${statVal(p,'metres')}</td><td>${p.stats?.career?.apps||0}</td></tr>`).join('')}</tbody></table></div></div>`}
function regulationsView16(){const c=user16(),r=state.save.world.reg,non=c.players.filter(p=>!isJiff(p)),pay=c.players.reduce((s,p)=>s+(p.salary||0)*12,0),cap=c.comp==='top14'?salaryCap16():DB.comps[c.comp]?.salaryCap||c.wageBudget||c.budget*.45,avg=+jiffAverage().toFixed(2);return `${worldNav('regulations')}<div class="world16-head"><div><span>RÈGLEMENT 2026-27</span><h2>Conformité sportive</h2><p>JIFF, liste non-JIFF, salary cap et règles d’accession intégrés au moteur de carrière.</p></div></div><div class="world16-reg-kpis"><div><small>Moyenne JIFF</small><b>${r.jiffSheets.length?avg:'—'}</b><span>objectif 16 / feuille</span></div><div><small>Non-JIFF effectif</small><b>${non.length}</b><span>${r.nonJiffRef.length}/13 inscrits</span></div><div><small>Masse salariale</small><b>${euro(pay)}</b><span>plafond ${euro(cap)}</span></div><div><small>Conformité</small><b class="${(r.jiffSheets.length&&avg<16)||r.nonJiffRef.length>13||pay>cap?'bad':'good'}">${(r.jiffSheets.length&&avg<16)||r.nonJiffRef.length>13||pay>cap?'À corriger':'OK'}</b></div></div><div class="world16-reg-grid"><section><h3>Liste de référence non-JIFF</h3><p>Maximum moteur : 13 joueurs. Un non-JIFF non inscrit ne peut pas être utilisé sur une feuille de match.</p>${non.map(p=>`<div class="world16-reg-player"><span><b>${X(p.first)} ${X(p.last)}</b><small>${p.pos} · ${X(p.nat)}</small></span><button class="${r.nonJiffRef.includes(p.id)?'on':''}" onclick="registerNonJiff('${p.id}')">${r.nonJiffRef.includes(p.id)?'Inscrit':'Inscrire'}</button></div>`).join('')||'<div class="world16-empty">Aucun non-JIFF dans l’effectif.</div>'}</section><section><h3>Règles de compétition</h3><div class="world16-rule"><b>TOP 14</b><span>14 clubs · 26 journées · top 6 · 14e relégué · 13e en Access Match.</span></div><div class="world16-rule"><b>PRO D2</b><span>16 clubs · 30 journées · top 6 · champion promu · finaliste en Access Match · 16e relégué.</span></div><div class="world16-rule"><b>Nationale</b><span>Champion promu · finaliste en Access Match face au 15e de PRO D2.</span></div><div class="world16-rule"><b>Salary cap TOP 14</b><span>${euro(salaryCap16())} pour ${seasonKey()}, puis progression jusqu’à 11,3 M€.</span></div></section></div>`}
function clubsView16(){const clubs=[...state.save.clubs].sort((a,b)=>(b.strength||0)-(a.strength||0));return `${worldNav('clubs')}<div class="world16-head"><div><span>INTELLIGENCE ARTIFICIELLE</span><h2>Les autres clubs</h2><p>Stratégie, entraîneur, pression, effectif et activité mercato évoluent désormais sans toi.</p></div></div><div class="world16-clubs">${clubs.map(c=>`<article class="${c.id===state.save.clubId?'mine':''}"><div><span>${X(DB.comps[c.comp]?.name||c.comp)}</span><b>${X(c.short)}</b></div><h3>${X(c.name)}</h3><p>${X(c.ai?.style||'Stable')} · Coach ${X(c.ai?.coach||'—')}</p><div><small>Niveau</small><strong>${c.strength}</strong><small>Effectif</small><strong>${c.players.length}</strong><small>Pression coach</small><strong>${c.ai?.pressure||0}%</strong></div></article>`).join('')}</div>`}
function worldView16(section){switch(section){case'news':return newsView16();case'competitions':return competitionsView16();case'stats':return statsView16();case'regulations':return regulationsView16();case'clubs':return clubsView16();default:return''}}
