function positionalNeed(c){const counts={};POS.forEach(p=>counts[p]=c.players.filter(x=>x.pos===p).length);const target={PIL:5,TAL:3,'2L':5,'3L':6,'9':3,'10':3,C:5,AIL:5,AR:3};return POS.sort((a,b)=>(counts[a]/target[a])-(counts[b]/target[b]))[0]}
function aiReleaseCandidate(c){return [...c.players].filter(p=>!p.loan).sort((a,b)=>((a.ca||0)+(a.potential||0)*.25-(a.age||25)*.7)-((b.ca||0)+(b.potential||0)*.25-(b.age||25)*.7))[0]}
function aiRenew(c){const end=year16(),exp=c.players.filter(p=>(p.contract||9999)<=end+1&&!p.loan);for(const p of exp.slice(0,2)){const keep=(p.ca||0)>=c.strength-7||(p.age||25)<=24;if(keep){p.contract=end+2+(H(p.id+end)%2);p.salary=Math.round((p.salary||2000)*(1.03+(H(p.id+'sal'+end)%8)/100)/100)*100;if(Math.random()<0){}news16('contract',`${c.short} prolonge ${p.last}`,`${p.first} ${p.last} reste à ${c.name} jusqu’en ${p.contract}.`,1)}else if((p.contract||0)<=end&&c.id!==state.save.clubId){c.players=c.players.filter(x=>x.id!==p.id);if(state.save.mgmt?.freeAgents)state.save.mgmt.freeAgents.push({...p,formerClub:c.name,freeSince:state.save.date});news16('contract',`${p.last} quitte ${c.short}`,`${p.first} ${p.last} ne sera pas prolongé.`,1)}}}
function aiTryTransfer(c){if(c.id===state.save.clubId||c.players.length<34)return;const need=positionalNeed(c),cands=state.save.clubs.filter(x=>x.id!==c.id&&x.id!==state.save.clubId).flatMap(x=>x.players.map(p=>({p,from:x}))).filter(x=>x.p.pos===need&&!x.p.loan&&(x.p.contract||9999)<=year16()+2&&(x.p.ca||0)>=c.strength-8).sort((a,b)=>(b.p.ca||0)-(a.p.ca||0));if(!cands.length)return;const pick=cands[H(c.id+state.save.round+need)%Math.min(8,cands.length)],p=pick.p,from=pick.from;const fee=Math.round(Math.max(30000,(p.value||((p.ca||60)**2*160)))*(.7+(H(p.id+c.id)%45)/100)/10000)*10000;if((c.transferBudget||0)<fee)return;from.players=from.players.filter(x=>x.id!==p.id);c.players.push({...p,contract:year16()+2+(H(p.id+'ct')%2),salary:Math.round((p.salary||2000)*1.08/100)*100});c.transferBudget=Math.max(0,(c.transferBudget||0)-fee);from.transferBudget=(from.transferBudget||0)+Math.round(fee*.75);c.cash=(c.cash||0)-fee;from.cash=(from.cash||0)+fee;c.ai.transfers++;state.save.world.aiMoves.unshift({round:state.save.round,playerId:p.id,from:from.id,to:c.id,fee});news16('transfer',`${c.short} recrute ${p.last}`,`${p.first} ${p.last} quitte ${from.name} pour ${c.name} contre ${euro(fee)}.`,2)}
function aiUseFreeAgent(c){const pool=state.save.mgmt?.freeAgents||[];if(c.id===state.save.clubId||!pool.length||c.players.length>=44)return;const need=positionalNeed(c),idx=pool.findIndex(p=>p.pos===need&&(p.ca||0)>=c.strength-10);if(idx<0)return;const p=pool.splice(idx,1)[0];p.contract=year16()+2;p.salary=Math.round((p.salary||1800)*1.04/100)*100;c.players.push(p);news16('transfer',`${c.short} signe un joueur libre`,`${p.first} ${p.last} s’engage libre avec ${c.name}.`,1)}
function aiPromoteYouth(c){if(c.id===state.save.clubId||c.players.length>=43)return;const seed=c.id+seasonKey()+'youth';if((H(seed+state.save.round)%5)!==0)return;const need=positionalNeed(c),age=18+(H(seed)%3),ca=clamp(Math.round(c.strength-18+(H(seed+'ca')%12)),48,75),pot=clamp(ca+10+(H(seed+'pot')%16),65,94),p={id:`${c.id}-regen-${seasonKey()}-${state.save.round}`,first:['Léo','Noé','Jules','Tom','Hugo','Louis'][H(seed+'f')%6],last:['Martin','Roussel','Lacombe','Borie','Aubert','Perrin'][H(seed+'l')%6],pos:need,age,nat:'France',jiff:true,jiffSource:'Centre de formation',height:184,weight:92,ca,potential:pot,salary:1200,contract:year16()+3,fitness:96,morale:82,attrs:{}};c.players.push(p);ensureStats(p);news16('academy','Un jeune lancé chez '+c.short,`${p.first} ${p.last}, ${p.pos}, intègre le groupe professionnel.`,1)}
function aiCoachPressure(c){if(c.id===state.save.clubId)return;const r=rank16(c.comp,c.id),count=state.save.clubs.filter(x=>x.comp===c.comp).length,expected=Math.max(1,Math.round(count-(c.strength-60)/3));let delta=r>expected+4?10:r<expected-2?-5:1;c.ai.pressure=clamp((c.ai.pressure||25)+delta,0,100);if(c.ai.pressure>=90&&(state.save.round||1)>8){const old=c.ai.coach;c.ai.coach=`${COACH_FIRST[H(c.id+state.save.round+'nf')%COACH_FIRST.length]} ${COACH_LAST[H(c.id+state.save.round+'nl')%COACH_LAST.length]}`;c.ai.coachRating=clamp(c.ai.coachRating-2+(H(c.id+'newq')%10),55,94);c.ai.pressure=32;news16('coach',`${c.short} change d’entraîneur`,`${old} quitte ses fonctions. ${c.ai.coach} prend les commandes.`,3)}}
function aiClubWeek(){const r=state.save.round||1;for(const c of state.save.clubs){if(c.id===state.save.clubId)continue;if(r%3===0)aiRenew(c);if(r%4===0)aiTryTransfer(c);if(r%5===0)aiUseFreeAgent(c);if(r%6===0)aiPromoteYouth(c);if(r%2===0)aiCoachPressure(c);if(c.players.length>47&&r%5===0){const p=aiReleaseCandidate(c);if(p){c.players=c.players.filter(x=>x.id!==p.id);if(state.save.mgmt?.freeAgents)state.save.mgmt.freeAgents.push({...p,formerClub:c.name});news16('squad',`${c.short} allège son effectif`,`${p.first} ${p.last} est libéré.`,1)}}}}
function registerNonJiff(pid){initWorld();const r=state.save.world.reg,c=user16(),p=c.players.find(x=>x.id===pid);if(!p||isJiff(p))return;if(r.nonJiffRef.includes(pid)){r.nonJiffRef=r.nonJiffRef.filter(x=>x!==pid);saveLocal();render();return}if(r.nonJiffRef.length>=13)return toast('La liste de référence est limitée à 13 non-JIFF.');r.nonJiffRef.push(pid);saveLocal();render()}
function matchRegCheck(){initWorld();const c=user16(),ids=[...(state.save.lineup||[]),...(state.save.bench||[])],players=ids.map(id=>c.players.find(p=>p.id===id)).filter(Boolean),bad=players.filter(p=>!isJiff(p)&&!state.save.world.reg.nonJiffRef.includes(p.id));if(bad.length)return `${bad.map(p=>p.last).join(', ')} non inscrit(s) sur la liste non-JIFF.`;const j=players.filter(isJiff).length;if(players.length>=20&&j<16)return `Attention : seulement ${j} JIFF sur la feuille. La moyenne cible est 16.`;return''}
