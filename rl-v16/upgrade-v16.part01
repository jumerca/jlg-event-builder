function startingXV(c,ids){if(ids?.length)return ids.map(id=>c.players.find(p=>p.id===id)).filter(Boolean).slice(0,15);return [...c.players].filter(p=>!p.injury?.weeks).sort((a,b)=>(b.ca||0)-(a.ca||0)).slice(0,15)}
function bench8(c,ids,starters){if(ids?.length)return ids.map(id=>c.players.find(p=>p.id===id)).filter(Boolean).slice(0,8);const used=new Set(starters.map(p=>p.id));return [...c.players].filter(p=>!used.has(p.id)&&!p.injury?.weeks).sort((a,b)=>(b.ca||0)-(a.ca||0)).slice(0,8)}
function actorForEvent(list,e,idx){if(!list.length)return null;const t=String(e?.type||'').toUpperCase();let n=t.includes('ESSAI')?([10,11,12,13,14,7][idx%6]):t.includes('DROP')?9:t.includes('PÉNAL')||t.includes('PENAL')?9:t.includes('TRANS')?9:t.includes('TOUCHE')?3:t.includes('MÊL')?0:idx%list.length;return list[Math.min(n,list.length-1)]}
function recordTeamMatch(c,starters,bench,scoreFor,scoreAgainst,events,isHome){
 const all=[...starters,...bench.filter(p=>!starters.some(s=>s.id===p.id))];all.forEach((p,i)=>{addStat(p,'apps');if(i<15)addStat(p,'starts');addStat(p,'mins',i<15?80:18+(H(p.id+state.save.round)%25));if(scoreFor>scoreAgainst)addStat(p,'wins');else if(scoreFor<scoreAgainst)addStat(p,'losses');addStat(p,'tackles',Math.max(1,Math.round((p.pos==='3L'||p.pos==='C'?9:6)+(H(p.id+'t'+state.save.round)%8))));addStat(p,'metres',Math.round((['AIL','AR','C'].includes(p.pos)?35:14)+(H(p.id+'m'+state.save.round)%45)))});
 let ei=0;for(const e of events||[]){if(!!e.home!==!!isHome)continue;const p=actorForEvent(starters,e,ei++);if(!p)continue;const t=String(e.type||'').toUpperCase();if(t.includes('ESSAI')){addStat(p,'tries');addStat(p,'points',5)}else if(t.includes('TRANS')){addStat(p,'conv');addStat(p,'points',2)}else if(t.includes('PÉNAL')||t.includes('PENAL')){addStat(p,'pens');addStat(p,'points',3)}else if(t.includes('DROP')){addStat(p,'drops');addStat(p,'points',3)}else if(t.includes('JAUNE'))addStat(p,'yellow');else if(t.includes('ROUGE'))addStat(p,'red')}
}
function recordMatchStats(snapshot){if(!snapshot)return;initWorld();const h=club16(snapshot.homeId),a=club16(snapshot.awayId);if(!h||!a)return;const hs=startingXV(h,snapshot.homeLineup),as=startingXV(a,snapshot.awayLineup),hb=bench8(h,snapshot.homeBench,hs),ab=bench8(a,snapshot.awayBench,as);recordTeamMatch(h,hs,hb,snapshot.hs,snapshot.as,snapshot.events,true);recordTeamMatch(a,as,ab,snapshot.as,snapshot.hs,snapshot.events,false);trackJiffSheet(snapshot,hs,hb,as,ab);const margin=Math.abs(snapshot.hs-snapshot.as);if(margin>=25)news16('result','Victoire marquante',`${snapshot.hs>snapshot.as?h.name:a.name} frappe fort : ${snapshot.hs}-${snapshot.as}.`,2);}
function trackJiffSheet(m,hs,hb,as,ab){const uc=user16();if(!uc)return;let sheet=null;if(m.homeId===uc.id)sheet=[...hs,...hb];else if(m.awayId===uc.id)sheet=[...as,...ab];if(!sheet)return;const j=sheet.filter(isJiff).length;state.save.world.reg.jiffSheets.push({round:state.save.round,count:j,total:sheet.length});state.save.world.reg.jiffSheets=state.save.world.reg.jiffSheets.slice(-40);if(j<16)state.save.world.reg.warnings.unshift({round:state.save.round,text:`Feuille à ${j} JIFF : moyenne réglementaire en danger.`});}
function jiffAverage(){const s=state.save.world.reg.jiffSheets;return s.length?avg16(s,x=>x.count):0}
function simulateCompRound(comp){const wc=state.save.world.comps[comp];if(!wc)return;if(state.save.competition===comp&&state.save.table?.length){wc.table=state.save.table.map(r=>({...r,p:r.p??((r.w||0)+(r.d||0)+(r.l||0))}));wc.round=Math.max(wc.round,state.save.round-1);return}const r=(state.save.round||1);if(wc.round>=r)return;const entry=wc.schedule.find(x=>x.round===r);if(!entry){wc.round=r;return}for(const g of entry.games){const h=club16(g.home),a=club16(g.away);if(!h||!a)continue;const [hs,as]=scorePair(h,a,`${seasonKey()}-${comp}-${r}-${g.home}-${g.away}`),rh=wc.table.find(x=>x.clubId===g.home),ra=wc.table.find(x=>x.clubId===g.away);if(rh&&ra)applyResult(rh,ra,hs,as);simulateAIPlayerStats(h,hs,as,r);simulateAIPlayerStats(a,as,hs,r)}wc.round=r;}
function simulateAIPlayerStats(c,pf,pa,r){if(c.id===state.save.clubId)return;const starters=[...c.players].filter(p=>!p.injury?.weeks).sort((a,b)=>(b.ca||0)-(a.ca||0)).slice(0,15),bench=bench8(c,null,starters);recordTeamMatch(c,starters,bench,pf,pa,[],true);const tries=Math.max(0,Math.floor(pf/10));for(let i=0;i<tries;i++){const p=starters[[10,11,12,13,14,7][(i+r)%6]||10];if(p){addStat(p,'tries');addStat(p,'points',5)}}const kicker=starters.find(p=>p.pos==='10')||starters[9];if(kicker){const rem=Math.max(0,pf-tries*5);addStat(kicker,'points',rem);addStat(kicker,'pens',Math.floor(rem/3))}}
function worldWeekly(){initWorld();const w=state.save.world,r=state.save.round||1;if(w.processedRounds.includes(r))return;w.processedRounds.push(r);w.processedRounds=w.processedRounds.slice(-50);['top14','prod2','nationale'].forEach(simulateCompRound);aiClubWeek();generateWorldNews();checkRegulations();}
function checkRegulations(){const uc=user16(),w=state.save.world;if(!uc)return;const non=uc.players.filter(p=>!isJiff(p));if(non.length>13)news16('regulation','Alerte joueurs non-JIFF',`${uc.name} compte ${non.length} non-JIFF dans l’effectif. Seuls 13 peuvent figurer sur la liste de référence du moteur réglementaire.`,2);if(uc.comp==='top14'){const pay=uc.players.reduce((s,p)=>s+(p.salary||0)*12,0),cap=salaryCap16();if(pay>cap)news16('regulation','Salary cap dépassé',`Masse salariale joueurs : ${euro(pay)} pour un plafond de jeu fixé à ${euro(cap)}.`,3)}}
function generateWorldNews(){
 const r=state.save.round||1;
 if(r%2===0){
  for(const comp of ['top14','prod2','nationale']){
   const t=table16(comp),lead=club16(t[0]?.clubId);
   if(lead)news16('table',`Leader ${DB.comps[comp]?.name||comp}`,`${lead.name} occupe la tête après ${t[0]?.p||0} match(s).`,1);
  }
 }
 if(r%4===0){
  const scorers=allPlayers().sort((a,b)=>(b.stats?.seasons?.[seasonKey()]?.tries||0)-(a.stats?.seasons?.[seasonKey()]?.tries||0));
  if(scorers[0])news16('stats','Le marqueur du moment',`${scorers[0].first} ${scorers[0].last} mène avec ${scorers[0].stats.seasons[seasonKey()].tries} essai(s).`,1);
 }
}
function allPlayers(){return state.save.clubs.flatMap(c=>c.players)}
