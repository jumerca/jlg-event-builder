e.save.mgmt.incoming=state.save.mgmt.incoming.filter(x=>x.id!==id);toast('Le club se retire des négociations.')}saveLocal();render()}
function acceptIncoming(id){const m=state.save.mgmt,o=m.incoming.find(x=>x.id===id);if(!o)return;const c=currentClub(),buyer=clubBy(o.fromClub),p=c.players.find(x=>x.id===o.playerId);if(!p||!buyer)return;c.players=c.players.filter(x=>x.id!==p.id);buyer.players.push({...p,contract:Math.max(p.contract||seasonEndYear(),seasonEndYear()+2),salary:Math.round(p.salary*1.08/100)*100});c.cash+=o.fee;c.transferBudget+=Math.round(o.fee*.82);buyer.cash-=o.fee;buyer.transferBudget=Math.max(0,(buyer.transferBudget||0)-o.fee);m.incoming=m.incoming.filter(x=>x.id!==id);delete m.listed[p.id];delete m.loanListed[p.id];logDeal('sale',`${p.first} ${p.last} est transféré à ${buyer.name}`,o.fee,{playerId:p.id,from:c.id,to:buyer.id});notify('Vente conclue',`${p.first} ${p.last} rejoint ${buyer.name} pour ${money(o.fee)}.`,'transfer');saveLocal();render();toast('Offre acceptée')}
function acceptIncomingLoan(id){const m=state.save.mgmt,o=m.incoming.find(x=>x.id===id);if(!o)return;const c=currentClub(),buyer=clubBy(o.fromClub),p=c.players.find(x=>x.id===o.playerId);if(!p||!buyer)return;c.players=c.players.filter(x=>x.id!==p.id);buyer.players.push({...p,loan:{from:c.id,to:buyer.id,wageShare:o.wageShare,fee:o.fee,startRound:state.save.round,endRound:999,originalSalary:p.salary},parentClubId:c.id});c.cash+=o.fee;c.transferBudget+=Math.round(o.fee*.8);m.loans.push({playerId:p.id,from:c.id,to:buyer.id,fee:o.fee,wageShare:o.wageShare,startRound:state.save.round,endRound:999,status:'active'});m.incoming=m.incoming.filter(x=>x.id!==id);delete m.loanListed[p.id];logDeal('loanout',`${p.first} ${p.last} est prêté à ${buyer.name}`,o.fee,{playerId:p.id,from:c.id,to:buyer.id});saveLocal();render();toast('Prêt accepté')}
function weeklyManagement(){
  if(!state.save?.mgmt)return;const m=state.save.mgmt,r=state.save.round||1;if(m.processedRounds.includes(r))return;m.processedRounds.push(r);m.processedRounds=m.processedRounds.slice(-45);
  // Return half-season loans.
  m.loans.filter(l=>l.status==='active'&&l.endRound!==999&&r>=l.endRound).forEach(l=>returnLoan(l));
  // AI offers for players put on transfer/loan list.
  const c=currentClub();if(c){
    Object.keys(m.listed).forEach(pid=>{if(m.incoming.some(o=>o.playerId===pid))return;const p=c.players.find(x=>x.id===pid);if(!p)return;if(((pid.length+r*7)%3)!==0)return;const buyers=state.save.clubs.filter(x=>x.id!==c.id&&x.comp===c.comp&&x.transferBudget>marketValue(p)*.5);if(!buyers.length)return;const b=buyers[(r+pid.length)%buyers.length],ask=m.listed[pid].price||marketValue(p);m.incoming.push({id:'io'+Date.now()+pid,playerId:pid,fromClub:b.id,type:'transfer',fee:roundK(ask*(.82+((r%4)*.05))),round:r});});
    Object.keys(m.loanListed).forEach(pid=>{if(m.incoming.some(o=>o.playerId===pid))return;const p=c.players.find(x=>x.id===pid);if(!p||((r+pid.length)%2))return;const buyers=state.save.clubs.filter(x=>x.id!==c.id&&x.comp!== 'top14');if(!buyers.length)return;const b=buyers[(r*3+pid.length)%buyers.length];m.incoming.push({id:'iol'+Date.now()+pid,playerId:pid,fromClub:b.id,type:'loan',fee:roundK(marketValue(p)*.04),wageShare:[50,75,100][r%3],round:r});});
  }
  // AI market activity every few rounds.
  if(r%3===0)simulateAITransfer();
  // Contract expiry after the final scheduled round.
  const maxRound=Math.max(...(state.save.schedule||[]).map(x=>x.round),0);if(r>maxRound&&!m.endSeasonProcessed){processExpiries();m.endSeasonProcessed=true}
}
function simulateAITransfer(){const m=state.save.mgmt,clubs=state.save.clubs.filter(c=>c.id!==state.save.clubId&&c.players.length>35);if(clubs.length<2)return;const from=clubs[(state.save.round*5)%clubs.length],to=clubs[(state.save.round*7+3)%clubs.length];if(from.id===to.id)return;const cand=from.players.filter(p=>p.contract<=seasonEndYear()+1&&p.ca<from.strength+4).sort((a,b)=>b.ca-a.ca)[0];if(!cand)return;const fee=roundK(marketValue(cand)*.82);if(fee>to.transferBudget)return;from.players=from.players.filter(x=>x.id!==cand.id);to.players.push({...cand,contract:seasonEndYear()+3,salary:Math.round(cand.salary*1.07/100)*100});from.cash+=fee;from.transferBudget+=Math.round(fee*.75);to.cash-=fee;to.transferBudget-=fee;logDeal('ai',`${cand.first} ${cand.last} : ${from.name} → ${to.name}`,fee,{playerId:cand.id,from:from.id,to:to.id})}
function returnLoan(l){const from=clubBy(l.from),to=clubBy(l.to);if(!from||!to)return;const p=to.players.find(x=>x.id===l.playerId);if(!p)return;to.players=to.players.filter(x=>x.id!==p.id);from.players.push({...p,loan:null,parentClubId:null});l.status='returned';logDeal('loanreturn',`${p.first} ${p.last} retourne à ${from.name}`,0,{playerId:p.id})}
function processExpiries(){const m=state.save.mgmt,end=seasonEndYear();state.save.clubs.forEach(c=>{const exp=c.players.filter(p=>(p.contract||9999)<=end&&!p.loan);exp.forEach(p=>{c.players=c.players.filter(x=>x.id!==p.id);m.freeAgents.push({...p,freeSince:`${end}-07-01`,formerClub:c.name});if(c.id===state.save.clubId)notify('Fin de contrat',`${p.first} ${p.last} quitte le club libre.`,'contract')})})}
function marketPlayers(){
  const m=state.save.mgmt,q=m.query.trim().toLowerCase(),pos=m.pos,comp=m.comp,own=state.save.clubId,arr=[];
  state.save.clubs.forEach(c=>{if(c.id===own)return;if(comp!=='ALL'&&c.comp!==comp)return;c.players.forEach(p=>{if(pos!=='ALL'&&p.pos!==pos)return;if(q&&!`${p.first} ${p.last} ${c.name} ${p.nat}`.toLowerCase().includes(q))return;arr.push({p,c,v:marketValue(p),ask:askPrice(p,c)})})});
  const sort=m.sort;arr.sort((a,b)=>sort==='rating'?b.p.ca-a.p.ca:sort==='potential'?b.p.potential-a.p.potential:sort==='age'?a.p.age-b.p.age:sort==='contract'?a.p.contract-b.p.contract:b.v-a.v);return arr.slice(0,160)
}
function mgmtHeader(active){const c=currentClub(),m=state.save.mgmt,items=[['market','Mercato'],['contracts','Contrats'],['loans','Prêts'],['offers',`Offres${m.incoming.length?` (${m.incoming.length})`:''}`],['free','Libres'],['history','Historique'],['budget','Budget']];return `<div class="mgmt-hero"><div><span class="mgmt-eyebrow">DIRECTION SPORTIVE</span><h2>Mercato & contrats</h2><p>${E(c.name)} · Saison ${seasonEndYear()-1}-${seasonEndYear()}</p></div><div class="mgmt-kpis"><div><small>Budget transferts</small><b>${money(c.transferBudget)}</b></div><div><small>Masse salariale</small><b>${money(payroll(c))}</b></div><div><small>Marge salaires</small><b>${money(wageRoom(c))}</b></div><div><small>Effectif</small><b>${c.players.length}</b></div></div></div><div class="mgmt-tabs">${items.map(([k,l])=>`<button class="${active===k?'active':''}" onclick="setMgmtTab('${k}')">${l}</button>`).join('')}</div>`}
function marketView14(){const m=state.save.mgmt,arr=marketPlayers();return `${mgmtHeader('market')}<div class="mgmt-toolbar"><input placeholder="Joueur, club, nationalité…" value="${E(m.query)}" oninput="setMarketQuery(this.value)"><select onchange="setMarketPos(this.value)">${POS.map(p=>`<option ${m.pos===p?'selected':''}>${p}</option>`).join('')}</select><select onchange="setMarketComp(this.value)"><option value="ALL">Toutes divisions</option>${Object.values(DB.comps).map(c=>`<option value="${c.id}" ${m.comp===c.id?'selected':''}>${c.name}</option>`).join('')}</select><select onchange="setMarketSort(this.value)"><option value="value" ${m.sort==='value'?'selected':''}>Valeur</option><option value="rating" ${m.sort==='rating'?'selected':''}>Niveau</option><option value="potential" ${m.sort==='potential'?'selected':''}>Potentiel</option><option value="age" ${m.sort==='age'?'selected':''}>Âge</option><option value="contract" ${m.sort==='contract'?'selected':''}>Fin contrat</option></select></div><div class="mgmt-table"><table><thead><tr><th></th><th>Joueur</th><th>Club</th><th>Poste</th><th>Âge</th><th>Niv.</th><th>Pot.</th><th>Contrat</th><th>Valeur</th><th>Prix</th><th>Salaire</th><th></th></tr></thead><tbody>${arr.map(({p,c,v,ask})=>{const short=m