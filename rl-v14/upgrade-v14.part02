d,fee,wageShare:share,startRound:state.save.round,endRound:np.loan.endRound,status:'active'});delete state.save.mgmt.loanListed[p.id];logDeal('loan',`${p.first} ${p.last} rejoint ${target.name} en prêt`,fee,{playerId:p.id,from:seller.id,to:target.id});notify('Prêt conclu',`${p.first} ${p.last} arrive de ${seller.name}. ${share}% du salaire pris en charge.`,'transfer');saveLocal();closeMgmtModal();toast('Prêt conclu');render();
}
function openRenewal(pid){
  initManagement();const p=currentClub().players.find(x=>x.id===pid);if(!p)return;const dem=Math.round(salaryDemand(p,currentClub())*1.02/100)*100;
  modal(`<div class="mgmt-modal-head"><div><span class="mgmt-eyebrow">PROLONGATION</span><h2>${E(p.first)} ${E(p.last)}</h2><p>${p.pos} · contrat actuel jusqu’en ${p.contract}</p></div><button onclick="closeMgmtModal()">✕</button></div><div class="mgmt-callout"><b>Position de l’agent</b><span>${E(p.agent)} vise environ ${money(dem)}/mois selon le statut proposé.</span></div><div class="mgmt-grid2"><label>Salaire mensuel<input id="renew-salary" type="number" min="500" step="100" value="${dem}"></label><label>Durée<select id="renew-years"><option>1</option><option>2</option><option selected>3</option><option>4</option></select></label><label>Prime de prolongation<input id="renew-bonus" type="number" min="0" step="1000" value="${Math.round(dem*1.5/1000)*1000}"></label><label>Clause de sortie<input id="renew-clause" type="number" min="0" step="50000" value="${roundK(marketValue(p)*2.3)}"></label></div><div class="mgmt-actions"><button class="btn" onclick="submitRenewal('${p.id}',${dem})">Proposer</button></div>`)
}
function submitRenewal(pid,demand){
  const c=currentClub(),p=c.players.find(x=>x.id===pid);if(!p)return;const sal=+document.getElementById('renew-salary').value||0,yrs=+document.getElementById('renew-years').value||2,bonus=+document.getElementById('renew-bonus').value||0,clause=+document.getElementById('renew-clause').value||0,old=p.salary*12,check=budgetCheck(0,bonus,sal*12,old);if(check)return toast(check);
  const score=sal/demand+(yrs>=3?.06:0)+(bonus>=sal?.05:0)+(p.morale||75)/1000;if(score<.92)return toast(`L’agent demande davantage. Base attendue : ${money(demand)}/mois.`);
  c.transferBudget-=bonus;c.cash-=bonus;p.salary=sal;p.contract=Math.max(p.contract||seasonEndYear(),seasonEndYear())+yrs;p.releaseClause=clause;logDeal('renewal',`${p.first} ${p.last} prolonge jusqu’en ${p.contract}`,bonus,{playerId:p.id});notify('Prolongation',`${p.first} ${p.last} a prolongé jusqu’en ${p.contract}.`,'contract');saveLocal();closeMgmtModal();render();toast('Prolongation signée')
}
function toggleTransferList(pid){initManagement();const m=state.save.mgmt,p=currentClub().players.find(x=>x.id===pid);if(!p)return;if(m.listed[pid])delete m.listed[pid];else m.listed[pid]={price:roundK(marketValue(p)*.95),round:state.save.round};saveLocal();render();}
function setListedPrice(pid,v){if(state.save.mgmt.listed[pid])state.save.mgmt.listed[pid].price=roundK(+v||0);saveLocal()}
function toggleLoanList(pid){initManagement();const m=state.save.mgmt;if(m.loanListed[pid])delete m.loanListed[pid];else m.loanListed[pid]={round:state.save.round};saveLocal();render()}
function openRelease(pid){const p=currentClub().players.find(x=>x.id===pid);if(!p)return;const years=Math.max(.5,contractYears(p)+.5),cost=roundK(p.salary*12*years*.55);modal(`<div class="mgmt-modal-head"><div><span class="mgmt-eyebrow">RÉSILIATION</span><h2>${E(p.first)} ${E(p.last)}</h2><p>Rupture anticipée du contrat</p></div><button onclick="closeMgmtModal()">✕</button></div><div class="mgmt-callout danger"><b>Indemnité estimée : ${money(cost)}</b><span>Le joueur quittera immédiatement l’effectif et deviendra libre. Cette somme sera débitée de la trésorerie et du budget disponible.</span></div><div class="mgmt-actions"><button class="btn danger" onclick="confirmRelease('${pid}',${cost})">Résilier le contrat</button><button class="btn ghost" onclick="closeMgmtModal()">Annuler</button></div>`)}
function confirmRelease(pid,cost){const c=currentClub(),p=c.players.find(x=>x.id===pid);if(!p)return;if(cost>c.transferBudget)return toast('Budget insuffisant pour financer la résiliation.');c.players=c.players.filter(x=>x.id!==pid);c.transferBudget-=cost;c.cash-=cost;state.save.mgmt.freeAgents.push({...p,freeSince:gameDate().toISOString().slice(0,10),formerClub:c.name});delete state.save.mgmt.listed[pid];delete state.save.mgmt.loanListed[pid];logDeal('release',`${p.first} ${p.last} quitte ${c.name} après résiliation`,cost,{playerId:p.id});notify('Contrat résilié',`${p.first} ${p.last} est désormais libre.`,'contract');saveLocal();closeMgmtModal();render();toast('Contrat résilié')}
function signFreeAgent(pid){initManagement();const p=state.save.mgmt.freeAgents.find(x=>x.id===pid);if(!p)return;const target=currentClub(),dem=salaryDemand(p,target);modal(`<div class="mgmt-modal-head"><div><span class="mgmt-eyebrow">JOUEUR LIBRE</span><h2>${E(p.first)} ${E(p.last)}</h2><p>${p.pos} · ${p.age} ans · ancien club ${E(p.formerClub||'—')}</p></div><button onclick="closeMgmtModal()">✕</button></div><div class="mgmt-grid2"><label>Salaire mensuel<input id="fa-salary" type="number" step="100" value="${dem}"></label><label>Durée<select id="fa-years"><option>1</option><option selected>2</option><option>3</option><option>4</option></select></label><label>Prime à la signature<input id="fa-bonus" type="number" step="1000" value="${Math.round(dem*2/1000)*1000}"></label><label>Clause de sortie<input id="fa-clause" type="number" step="50000" value="${roundK(marketValue(p)*2)}"></label></div><div class="mgmt-actions"><button class="btn" onclick="completeFreeAgent('${pid}',${dem})">Proposer le contrat</button></div>`)}
function completeFreeAgent(pid,demand){const m=state.save.mgmt,i=m.freeAgents.findIndex(x=>x.id===pid);if(i<0)return;const p=m.freeAgents[i],c=currentClub(),sal=+document.getElementById('fa-salary').value||0,yrs=+document.getElementById('fa-years').value||2,bonus=+document.getElementById('fa-bonus').value||0,clause=+document.getElementById('fa-clause').value||0,check=budgetCheck(0,bonus,sal*12);if(check)return toast(check);if(sal<demand*.92)return toast('Le joueur refuse cette proposition salariale.');m.freeAgents.splice(i,1);c.players.push({...p,salary:sal,contract:seasonEndYear()+yrs,releaseClause:clause,formerClub:undefined,freeSince:undefined});c.transferBudget-=bonus;c.cash-=bonus;logDeal('free',`${p.first} ${p.last} signe libre à ${c.name}`,bonus,{playerId:p.id,to:c.id});notify('Arrivée libre',`${p.first} ${p.last} signe jusqu’en ${seasonEndYear()+yrs}.`,'transfer');saveLocal();closeMgmtModal();render();toast('Joueur signé')}
function incomingOfferHtml(o){const p=currentClub().players.find(x=>x.id===o.playerId),buyer=clubBy(o.fromClub);if(!p||!buyer)return'';return `<div class="mgmt-offer"><div><span class="mgmt-badge">${o.type==='loan'?'PRÊT':'TRANSFERT'}</span><h3>${E(p.first)} ${E(p.last)}</h3><p>${E(buyer.name)} · ${o.type==='loan'?`${o.wageShare}% salaire + ${money(o.fee)}`:`${money(o.fee)}`}</p></div><div class="mgmt-actions">${o.type==='loan'?`<button class="btn" onclick="acceptIncomingLoan('${o.id}')">Accepter</button>`:`<button class="btn" onclick="acceptIncoming('${o.id}')">Accepter</button><button class="btn secondary" onclick="counterIncoming('${o.id}')">Contre-offre</button>`}<button class="btn ghost" onclick="rejectIncoming('${o.id}')">Refuser</button></div></div>`}
function rejectIncoming(id){state.save.mgmt.incoming=state.save.mgmt.incoming.filter(x=>x.id!==id);saveLocal();render()}
function counterIncoming(id){const o=state.save.mgmt.incoming.find(x=>x.id===id);if(!o)return;o.fee=roundK(o.fee*1.18);o.countered=true;const buyer=clubBy(o.fromClub),p=currentClub().players.find(x=>x.id===o.playerId);const max=askPrice(p,currentClub())*1.18;if(o.fee<=max){o.fee=roundK(Math.min(o.fee,max));toast(`${buyer.name} étudie ta contre-proposition.`)}else{stat