wageBudget(c);return `<div class="section-title"><h2>Club & finances</h2><p>${E(c.city)} · Direction générale</p></div><div class="grid four"><div class="card"><div class="meta">Budget annuel</div><div class="stat" style="font-size:20px">${money(c.budget)}</div></div><div class="card"><div class="meta">Budget transferts</div><div class="stat" style="font-size:20px">${money(c.transferBudget)}</div></div><div class="card"><div class="meta">Masse salariale</div><div class="stat" style="font-size:20px">${money(pay)}</div><div class="meta">${Math.round(pay/wb*100)}% du plafond</div></div><div class="card"><div class="meta">Trésorerie</div><div class="stat" style="font-size:20px">${money(c.cash)}</div></div></div><div class="grid two" style="margin-top:12px"><div class="card"><h3>Infrastructures</h3>${[['Centre d’entraînement',c.facilities],['Formation',c.academy],['Recrutement',Math.round((c.facilities+c.academy)/2)]].map(x=>`<div class="row"><span>${x[0]}</span><strong>${x[1]}/10</strong></div>`).join('')}</div><div class="card"><h3>Direction sportive</h3><div class="row"><span>Marge salariale</span><strong>${money(wageRoom(c))}</strong></div><div class="row"><span>Fins de contrat</span><strong>${c.players.filter(p=>p.contract<=seasonEndYear()).length}</strong></div><div class="row"><span>Offres reçues</span><strong>${state.save.mgmt.incoming.length}</strong></div><div class="actions"><button class="btn" onclick="state.tab='more';state.save.mgmt.marketTab='market';render()">Ouvrir le mercato</button><button class="btn secondary" onclick="state.tab='more';state.save.mgmt.marketTab='budget';render()">Budget détaillé</button></div></div></div>`};
// Rich own-player card with contract actions.
playerModal=function(id){initManagement();const p=currentClub().players.find(x=>x.id===id);if(!p)return;const keys=Object.entries(p.attrs||{}).sort((a,b)=>b[1]-a[1]),m=state.save.mgmt;modal(`<div class="mgmt-modal-head"><div><span class="mgmt-eyebrow">DOSSIER JOUEUR</span><h2>${E(p.first)} ${E(p.last)}</h2><p>${p.pos} · ${p.age} ans · ${E(p.nat)} · ${p.height} cm / ${p.weight} kg</p></div><button onclick="closeMgmtModal()">✕</button></div><div class="mgmt-player-summary"><div><small>Niveau</small><b>${p.ca}</b></div><div><small>Potentiel</small><b>${p.potential}</b></div><div><small>Valeur</small><b>${money(marketValue(p))}</b></div><div><small>Salaire</small><b>${money(p.salary)}/m</b></div><div><small>Contrat</small><b>${p.contract}</b></div><div><small>Agent</small><b>${E(p.agent)}</b></div></div><div class="mgmt-attrs">${keys.slice(0,10).map(([k,v])=>`<div><span>${E(k)}</span><i><b style="width:${v*5}%"></b></i><strong>${v}</strong></div>`).join('')}</div><div class="mgmt-actions"><button class="btn" onclick="closeMgmtModal();openRenewal('${p.id}')">Prolonger</button><button class="btn secondary" onclick="closeMgmtModal();toggleTransferList('${p.id}')">${m.listed[p.id]?'Retirer de la liste':'Placer sur liste'}</button><button class="btn secondary" onclick="closeMgmtModal();toggleLoanList('${p.id}')">${m.loanListed[p.id]?'Retirer du prêt':'Proposer en prêt'}</button><button class="btn danger" onclick="closeMgmtModal();openRelease('${p.id}')">Résilier</button></div>`)};
// Add management processing to weekly progression.
const previousCommit=commitMatch;commitMatch=function(){previousCommit();if(state.save){initManagement();saveLocal();render()}};
const previousContinue=continueCareer;continueCareer=function(){previousContinue();if(state.save){initManagement();saveLocal();render()}};
const previousStartClub=startClub;startClub=function(id){previousStartClub(id);if(state.save){initManagement();saveLocal();render()}};
const previousBuildCustom=buildCustomClub;buildCustomClub=function(){previousBuildCustom();if(state.save){initManagement();saveLocal();render()}};
// Expose handlers used by inline UI.
Object.assign(window,{setMgmtTab,setMarketQuery,setMarketPos,setMarketComp,setMarketSort,shortlistToggle,openTransfer,submitClubOffer,skipToContract,triggerClause,submitContractOffer,openLoan,submitLoanOffer,openRenewal,submitRenewal,toggleTransferList,setListedPrice,toggleLoanList,openRelease,confirmRelease,signFreeAgent,completeFreeAgent,rejectIncoming,counterIncoming,acceptIncoming,acceptIncomingLoan,closeMgmtModal});
if(state.save){initManagement();saveLocal()}
})();
