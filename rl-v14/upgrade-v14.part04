.shortlist.includes(p.id),exp=p.contract<=seasonEndYear();return `<tr><td><button class="star ${short?'on':''}" onclick="shortlistToggle('${p.id}')">★</button></td><td><b>${E(p.first)} ${E(p.last)}</b><small>${E(p.nat)} · ${E(p.agent)}</small></td><td>${E(c.short)}<small>${E(c.name)}</small></td><td><span class="pos">${p.pos}</span></td><td>${p.age}</td><td><span class="rating ${p.ca>82?'hi':p.ca>72?'mid':''}">${p.ca}</span></td><td>${p.potential}</td><td><span class="mgmt-contract ${exp?'exp':''}">${p.contract}</span></td><td>${money(v)}</td><td><b>${exp?'Libre*':money(ask)}</b></td><td>${money(p.salary)}/m</td><td><div class="row-actions"><button onclick="openTransfer('${c.id}','${p.id}')">Négocier</button><button onclick="openLoan('${c.id}','${p.id}')">Prêt</button></div></td></tr>`}).join('')}</tbody></table></div><p class="mgmt-footnote">* Un joueur en fin de contrat peut être approché librement pendant la période autorisée par le moteur de carrière.</p>`}
function contractsView14(){const c=currentClub(),m=state.save.mgmt,players=[...c.players].sort((a,b)=>a.contract-b.contract||b.ca-a.ca);return `${mgmtHeader('contracts')}<div class="mgmt-section-title"><div><h3>Contrats de l’effectif</h3><p>${players.filter(p=>p.contract<=seasonEndYear()).length} fin(s) de contrat cette saison</p></div></div><div class="mgmt-table"><table><thead><tr><th>Joueur</th><th>Poste</th><th>Âge</th><th>Niveau</th><th>Salaire</th><th>Fin</th><th>Valeur</th><th>Statut marché</th><th></th></tr></thead><tbody>${players.map(p=>`<tr><td><b>${E(p.first)} ${E(p.last)}</b><small>${E(p.role)} · ${E(p.agent)}</small></td><td><span class="pos">${p.pos}</span></td><td>${p.age}</td><td>${p.ca}</td><td>${money(p.salary)}/m</td><td><span class="mgmt-contract ${p.contract<=seasonEndYear()?'exp':''}">${p.contract}</span></td><td>${money(marketValue(p))}</td><td>${m.listed[p.id]?`<span class="mgmt-badge warn">TRANSFERT ${money(m.listed[p.id].price)}</span>`:m.loanListed[p.id]?'<span class="mgmt-badge blue">PRÊT</span>':'—'}</td><td><div class="row-actions"><button onclick="openRenewal('${p.id}')">Prolonger</button><button onclick="toggleTransferList('${p.id}')">${m.listed[p.id]?'Retirer liste':'Transfert'}</button><button onclick="toggleLoanList('${p.id}')">${m.loanListed[p.id]?'Retirer prêt':'Prêter'}</button><button class="danger" onclick="openRelease('${p.id}')">Résilier</button></div></td></tr>`).join('')}</tbody></table></div>`}
function loansView14(){const m=state.save.mgmt,active=m.loans.filter(l=>l.status==='active');return `${mgmtHeader('loans')}<div class="mgmt-grid-cards"><div class="mgmt-card"><small>Prêts actifs</small><b>${active.length}</b><span>${active.filter(x=>x.to===state.save.clubId).length} entrant(s) · ${active.filter(x=>x.from===state.save.clubId).length} sortant(s)</span></div><div class="mgmt-card"><small>Disponibles au prêt</small><b>${Object.keys(m.loanListed).length}</b><span>Joueurs de ton effectif proposés</span></div></div><div class="mgmt-section-title"><div><h3>Mouvements de prêt</h3><p>Indemnité, prise en charge du salaire et club parent suivis automatiquement.</p></div></div>${active.length?`<div class="mgmt-table"><table><thead><tr><th>Joueur</th><th>De</th><th>Vers</th><th>Salaire</th><th>Indemnité</th><th>Échéance</th></tr></thead><tbody>${active.map(l=>{const from=clubBy(l.from),to=clubBy(l.to),p=(to?.players||[]).find(x=>x.id===l.playerId)||(from?.players||[]).find(x=>x.id===l.playerId);return `<tr><td><b>${p?E(p.first+' '+p.last):'Joueur'}</b></td><td>${E(from?.name||'—')}</td><td>${E(to?.name||'—')}</td><td>${l.wageShare}% par club d’accueil</td><td>${money(l.fee)}</td><td>${l.endRound===999?'Fin saison':`J${l.endRound}`}</td></tr>`}).join('')}</tbody></table></div>`:'<div class="mgmt-empty">Aucun prêt actif pour le moment.</div>'}`}
function offersView14(){const m=state.save.mgmt;return `${mgmtHeader('offers')}<div class="mgmt-section-title"><div><h3>Offres reçues</h3><p>Les clubs IA peuvent répondre aux joueurs placés sur liste des transferts ou des prêts.</p></div></div>${m.incoming.length?m.incoming.map(incomingOfferHtml).join(''):'<div class="mgmt-empty">Aucune offre reçue actuellement. Place un joueur sur la liste pour attirer des clubs.</div>'}`}
function freeView14(){const m=state.save.mgmt;return `${mgmtHeader('free')}<div class="mgmt-section-title"><div><h3>Joueurs libres</h3><p>Aucune indemnité de transfert, mais prime et salaire restent à négocier.</p></div></div>${m.freeAgents.length?`<div class="mgmt-table"><table><thead><tr><th>Joueur</th><th>Poste</th><th>Âge</th><th>Niveau</th><th>Potentiel</th><th>Ancien club</th><th>Salaire précédent</th><th></th></tr></thead><tbody>${m.freeAgents.map(p=>`<tr><td><b>${E(p.first)} ${E(p.last)}</b><small>${E(p.nat)}</small></td><td><span class="pos">${p.pos}</span></td><td>${p.age}</td><td>${p.ca}</td><td>${p.potential}</td><td>${E(p.formerClub||'—')}</td><td>${money(p.salary)}/m</td><td><button class="mini-btn" onclick="signFreeAgent('${p.id}')">Négocier</button></td></tr>`).join('')}</tbody></table></div>`:'<div class="mgmt-empty">Aucun joueur libre dans la base pour le moment.</div>'}`}
function historyView14(){const m=state.save.mgmt;return `${mgmtHeader('history')}<div class="mgmt-section-title"><div><h3>Historique du mercato</h3><p>Transferts, prêts, résiliations, prolongations et mouvements IA.</p></div></div>${m.history.length?`<div class="mgmt-history">${m.history.map(h=>`<div><span class="mgmt-badge ${h.type==='sale'||h.type==='transfer'?'good':h.type.includes('release')?'warn':'blue'}">${E(h.type.toUpperCase())}</span><p><b>${E(h.text)}</b><small>${E(h.date)} · J${h.round}</small></p><strong>${h.amount?money(h.amount):'—'}</strong></div>`).join('')}</div>`:'<div class="mgmt-empty">Aucun mouvement enregistré.</div>'}`}
function budgetView14(){const c=currentClub(),pay=payroll(c),wb=wageBudget(c),cap=DB.comps[c.comp]?.salaryCap;return `${mgmtHeader('budget')}<div class="mgmt-grid-cards four"><div class="mgmt-card"><small>Budget club</small><b>${money(c.budget)}</b><span>Budget annuel global</span></div><div class="mgmt-card"><small>Trésorerie</small><b>${money(c.cash)}</b><span>Cash disponible</span></div><div class="mgmt-card"><small>Budget transferts</small><b>${money(c.transferBudget)}</b><span>Indemnités + primes</span></div><div class="mgmt-card"><small>Masse salariale</small><b>${money(pay)}</b><span>${Math.round(pay/wb*100)}% du plafond interne</span></div></div><div class="mgmt-budget-box"><div><h3>Contrôle salarial</h3><p>Plafond ${cap?'réglementaire / interne':'interne'} : <b>${money(wb)}</b></p><div class="mgmt-bar"><i style="width:${clamp(pay/wb*100,0,100)}%"></i></div><div class="mgmt-budget-legend"><span>Engagé ${money(pay)}</span><span>Disponible ${money(Math.max(0,wb-pay))}</span></div></div><div><h3>Projection mercato</h3><div class="mgmt-budget-row"><span>Joueurs sous contrat</span><b>${c.players.length}</b></div><div class="mgmt-budget-row"><span>Fins de contrat ${seasonEndYear()}</span><b>${c.players.filter(p=>p.contract<=seasonEndYear()).length}</b></div><div class="mgmt-budget-row"><span>Sur liste transferts</span><b>${Object.keys(state.save.mgmt.listed).length}</b></div><div class="mgmt-budget-row"><span>Offres en attente</span><b>${state.save.mgmt.incoming.length}</b></div></div></div>`}
function managementView(){initManagement();switch(state.save.mgmt.marketTab){case'contracts':return contractsView14();case'loans':return loansView14();case'offers':return offersView14();case'free':return freeView14();case'history':return historyView14();case'budget':return budgetView14();default:return marketView14()}}
// Replace the placeholder management area with the complete sporting director suite.
moreView=function(){return managementView()};
// Upgrade Club finances with direct access to the mercato budget.
const oldClubView=clubView;clubView=function(){initManagement();const c=currentClub(),pay=payroll(c),wb=