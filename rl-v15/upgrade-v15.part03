function academyView(){const a=state.save.ops.academy,c=userClub();return `${opsHeader('academy')}<div class="ops-grid4"><div class="ops-kpi"><span>Niveau formation</span><b>${c.academy}/10</b></div><div class="ops-kpi"><span>Directeur</span><b>${staffQ('academy')}</b></div><div class="ops-kpi"><span>Espoirs</span><b>${a.players.length}</b></div><div class="ops-kpi"><span>Promus</span><b>${a.promoted}</b></div></div><div class="ops-section-title"><div><h3>Centre de formation</h3><p>Progression automatique chaque semaine selon infrastructures et staff.</p></div><button class="btn secondary" onclick="academyTrialDay()">Journée de détection · 15 k€</button></div><div class="ops-youth-grid">${a.players.sort((x,y)=>y.potential-x.potential).map(p=>`<div class="ops-youth"><div><span>${p.pos} · ${p.age} ans</span><h3>${X(p.first)} ${X(p.last)}</h3><p>Niv. ${p.ca} · Pot. ${p.potential} · ${p.height} cm / ${p.weight} kg</p></div><div class="ops-actions"><button onclick="promoteYouth('${p.id}')" ${p.age<18?'disabled':''}>Promouvoir</button><button class="ghost" onclick="releaseYouth('${p.id}')">Libérer</button></div></div>`).join('')}</div>`}
function academyTrialDay(){const c=userClub(),a=state.save.ops.academy;if(c.cash<15000)return toast('Trésorerie insuffisante');c.cash-=15000;const newcomers=academyIntake(c,3);a.players.push(...newcomers);saveLocal();render();toast('3 nouveaux jeunes observés')}
function promoteYouth(id){const c=userClub(),a=state.save.ops.academy,i=a.players.findIndex(x=>x.id===id);if(i<0)return;const p=a.players[i];if(p.age<18)return toast('Joueur trop jeune pour intégrer le groupe pro.');a.players.splice(i,1);a.promoted++;c.players.push({...p,academy:false,salary:800+Math.round(p.ca*12/100)*100,contract:seasonEndYear()+3,role:'Développement',seasonStarts:0,seasonApps:0});state.save.inbox.push({title:'Centre de formation',body:`${p.first} ${p.last} signe son premier contrat professionnel.`,type:'academy'});saveLocal();render();toast('Jeune promu en équipe première')}
function releaseYouth(id){const a=state.save.ops.academy,p=a.players.find(x=>x.id===id);if(!p)return;a.players=a.players.filter(x=>x.id!==id);a.released++;saveLocal();render();toast('Joueur libéré du centre')}
function saveTrainingPlan(){const o=state.save.ops.training;o.focus=document.getElementById('tr-focus').value;o.intensity=document.getElementById('tr-intensity').value;state.save.training=o.focus;saveLocal();render();toast('Plan hebdomadaire enregistré')}
function setIndividualTraining(id,v){state.save.ops.training.individual[id]=v;saveLocal()}
function trainingView15(){const o=state.save.ops,c=userClub(),focuses=Object.keys(TRAINING);return `${opsHeader('training')}<div class="ops-train-top"><div class="ops-card"><h3>Plan collectif</h3><div class="ops-grid2"><label>Focus<select id="tr-focus">${focuses.map(x=>`<option ${o.training.focus===x?'selected':''}>${x}</option>`).join('')}</select></label><label>Intensité<select id="tr-intensity">${['Légère','Standard','Élevée'].map(x=>`<option ${o.training.intensity===x?'selected':''}>${x}</option>`).join('')}</select></label></div><button class="btn" onclick="saveTrainingPlan()">Enregistrer</button></div><div class="ops-card"><h3>Effets actuels</h3><div class="ops-metric"><span>Qualité coaching</span><b>${Math.round(trainingBoost()*100)}%</b></div><div class="ops-metric"><span>Condition moyenne</span><b>${Math.round(avg(c.players,p=>p.fitness||90))}%</b></div><div class="ops-metric"><span>Risque blessure</span><b>${o.training.intensity==='Élevée'?'Élevé':o.training.intensity==='Légère'?'Faible':'Normal'}</b></div></div></div><div class="ops-section-title"><div><h3>Travail individuel</h3><p>Le choix individuel remplace le focus collectif pour le joueur.</p></div></div><div class="ops-table"><table><thead><tr><th>Joueur</th><th>Âge</th><th>Niv.</th><th>Pot.</th><th>Progression</th><th>Condition</th><th>Focus</th></tr></thead><tbody>${[...c.players].sort((a,b)=>b.potential-a.potential).map(p=>`<tr><td><b>${X(p.first)} ${X(p.last)}</b><small>${p.pos} · ${X(p.role)}</small></td><td>${p.age}</td><td>${p.ca}</td><td>${p.potential}</td><td><div class="ops-mini-progress"><i style="width:${clamp((p.devProgress||0)*100,0,100)}%"></i></div></td><td>${Math.round(p.fitness||90)}%</td><td><select onchange="setIndividualTraining('${p.id}',this.value)"><option value="">Collectif</option>${focuses.map(x=>`<option ${o.training.individual[p.id]===x?'selected':''}>${x}</option>`).join('')}</select></td></tr>`).join('')}</tbody></table></div>`}
function medicalView(){const o=state.save.ops,c=userClub(),inj=c.players.filter(p=>p.injury?.weeks>0);return `${opsHeader('medical')}<div class="ops-grid4"><div class="ops-kpi"><span>Indisponibles</span><b>${inj.length}</b></div><div class="ops-kpi"><span>Médecin</span><b>${staffQ('doctor')}</b></div><div class="ops-kpi"><span>Kinésithérapeute</span><b>${staffQ('physio')}</b></div><div class="ops-kpi"><span>Centre médical</span><b>${facility('medical')}/10</b></div></div><div class="ops-section-title"><div><h3>Infirmerie</h3><p>Les durées sont réduites par la qualité du pôle médical.</p></div></div>${inj.length?`<div class="ops-medical-list">${inj.map(p=>`<div><div><h3>${X(p.first)} ${X(p.last)}</h3><p>${p.pos} · condition ${Math.round(p.fitness||0)}%</p></div><span>${X(p.injury.type)}</span><b>${p.injury.weeks} sem.</b></div>`).join('')}</div>`:'<div class="ops-empty">Aucun joueur indisponible.</div>'}<div class="ops-section-title"><div><h3>Historique médical</h3></div></div><div class="ops-history-mini">${o.medical.history.slice(0,12).map(h=>{const p=c.players.find(x=>x.id===h.playerId);return `<div><span>${p?X(p.first+' '+p.last):'Ancien joueur'}</span><b>${X(h.type)}</b><small>Retour J${h.returnedRound||'—'}</small></div>`}).join('')||'<span class="meta">Aucun historique.</span>'}</div>`}
function boardView(){const o=state.save.ops,c=userClub(),rank=typeof getRank==='function'?getRank(c.id):'-',target=targetRank(c),mor=Math.round(avg(c.players,p=>p.morale||75)),end=state.save.round>maxRound();return `${opsHeader('board')}<div class="ops-board-score"><div><span>CONFIANCE DE LA DIRECTION</span><b>${Math.round(o.board.confidence)}%</b><div class="ops-confidence"><i style="width:${o.board.confidence}%"></i></div></div><p>${o.board.confidence>=75?'La direction est très satisfaite.':o.board.confidence>=55?'La direction te soutient, mais surveille les objectifs.':o.board.confidence>=35?'La pression augmente : résultats et finances doivent progresser.':'Ta position est sérieusement menacée.'}</p></div><div class="ops-objectives"><div><span>Objectif sportif</span><b>${X(c.board)}</b><small>Classement actuel : ${rank}e · cible ≈ ${target}e</small></div><div><span>Gestion financière</span><b>${c.cash>=0?'Maîtrisée':'Sous tension'}</b><small>Trésorerie ${euro(c.cash)}</small></div><div><span>Formation</span><b>${o.academy.promoted} promu(s)</b><small>Centre ${c.academy}/10</small></div><div><span>Vie du groupe</span><b>${mor}% moral</b><small>${c.players.filter(p=>p.morale<55).length} joueur(s) mécontent(s)</small></div></div>${end?`<div class="ops-season-end"><h2>Saison terminée</h2><p>Le championnat est terminé. Tu peux lancer la saison suivante : vieillissement, mouvements de divisions, nouveaux jeunes, nouveaux budgets et calendrier.</p><button class="btn" onclick="advanceSeason15()">Passer à la saison ${seasonEndYear()}-${seasonEndYear()+1}</button></div>`:''}`}
