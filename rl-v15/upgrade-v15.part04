function infraUpgrade(key){const c=userClub(),lvl=facility(key);if(lvl>=10)return toast('Infrastructure déjà au niveau maximum');const cost=(lvl+1)*75000;if(c.cash<cost)return toast(`Il faut ${euro(cost)} de trésorerie.`);c.cash-=cost;if(key==='training')c.facilities++;else if(key==='academy')c.academy++;else state.save.ops.facilities[key]=lvl+1;state.save.ops.financeLedger.unshift({round:state.save.round,type:'infra',net:-cost,text:`Amélioration ${key}`});saveLocal();render();toast('Infrastructure améliorée')}
function overviewView(){const o=state.save.ops,c=userClub(),inj=c.players.filter(p=>p.injury?.weeks>0).length,missions=o.scouting.missions.filter(x=>x.status==='active').length,mor=Math.round(avg(c.players,p=>p.morale||75));return `${opsHeader('overview')}<div class="ops-grid4"><div class="ops-kpi"><span>Confiance</span><b>${Math.round(o.board.confidence)}%</b></div><div class="ops-kpi"><span>Moral groupe</span><b>${mor}%</b></div><div class="ops-kpi"><span>Infirmerie</span><b>${inj}</b></div><div class="ops-kpi"><span>Missions scouting</span><b>${missions}</b></div></div><div class="ops-section-title"><div><h3>Infrastructures</h3><p>Chaque niveau améliore directement les systèmes du club.</p></div></div><div class="ops-infra-grid">${[['training','Centre d’entraînement',c.facilities,'Progression et condition'],['academy','Centre de formation',c.academy,'Qualité des jeunes'],['medical','Pôle médical',facility('medical'),'Prévention et récupération'],['scouting','Cellule recrutement',facility('scouting'),'Précision des rapports']].map(([k,n,l,d])=>`<div><span>${n}</span><b>${l}/10</b><p>${d}</p><button onclick="infraUpgrade('${k}')" ${l>=10?'disabled':''}>Améliorer · ${euro((l+1)*75000)}</button></div>`).join('')}</div><div class="ops-overview-columns"><div class="ops-card"><h3>Développement récent</h3>${o.development.slice(0,8).map(d=>`<div class="ops-line"><span>J${d.round}</span><b>${X(d.text)}</b></div>`).join('')||'<p class="meta">Pas encore de progression enregistrée.</p>'}</div><div class="ops-card"><h3>Flux financier récent</h3>${o.financeLedger.slice(0,6).map(f=>`<div class="ops-line"><span>J${f.round}</span><b class="${(f.net||0)>=0?'poscash':'negcash'}">${(f.net||0)>=0?'+':''}${euro(f.net||0)}</b></div>`).join('')||'<p class="meta">Aucun mouvement hebdomadaire.</p>'}</div></div>`}
function opsHeader(active){const o=state.save.ops,c=userClub(),tabs=[['overview','Vue club'],['staff','Staff'],['training','Entraînement'],['medical','Médical'],['scouting','Scouting'],['academy','Formation'],['board','Direction']];return `<div class="ops-hero"><div><span class="ops-eyebrow">CLUB HOUSE · V1.5</span><h2>${X(c.name)}</h2><p>${DB.comps[c.comp]?.name||c.comp} · J${state.save.round} · ${c.players.length} pros</p></div><div><small>Trésorerie</small><b>${euro(c.cash)}</b></div></div><div class="ops-tabs">${tabs.map(([k,l])=>`<button class="${active===k?'active':''}" onclick="setOpsTab('${k}')">${l}</button>`).join('')}</div>`}
function clubOperationsView(){initOps();switch(state.save.ops.tab){case'staff':return staffView();case'training':return trainingView15();case'medical':return medicalView();case'scouting':return scoutingView();case'academy':return academyView();case'board':return boardView();default:return overviewView()}}
function modal15(html){document.querySelectorAll('.ops-modal15').forEach(x=>x.remove());document.body.insertAdjacentHTML('beforeend',`<div class="ops-modal15" onclick="if(event.target===this)this.remove()"><div class="ops-dialog">${html}</div></div>`)}
function closeOpsModal(){document.querySelectorAll('.ops-modal15').forEach(x=>x.remove())}
function rankIds(comp){const clubs=state.save.clubs.filter(c=>c.comp===comp);if(state.save.competition===comp&&state.save.table?.length){return [...state.save.table].sort((a,b)=>b.pts-a.pts||((b.pf-b.pa)-(a.pf-a.pa))).map(x=>x.clubId)}return clubs.sort((a,b)=>(b.strength+(hash(b.id+seasonEndYear())%9))-(a.strength+(hash(a.id+seasonEndYear())%9))).map(c=>c.id)}
function swapDivision(upId,downId,upComp,downComp){const up=club(upId),down=club(downId);if(!up||!down)return;up.comp=upComp;down.comp=downComp;up.budget=Math.round(up.budget*1.22);down.budget=Math.round(down.budget*.84);up.cash+=300000;down.cash+=100000}
function recalcBoard(c){const peers=state.save.clubs.filter(x=>x.comp===c.comp).sort((a,b)=>b.strength-a.strength),rank=peers.findIndex(x=>x.id===c.id)+1;if(c.comp==='top14')return rank<=3?'Titre':rank<=7?'Phases finales':'Maintien';if(c.comp==='prod2')return rank<=4?'Montée':rank<=8?'Top 6':'Maintien';return rank<=4?'Montée':'Stabiliser'}
function advanceSeason15(){
 if(state.save.round<=maxRound())return toast('La saison n’est pas terminée.');initOps();const c=userClub(),oldYear=seasonEndYear(),top=rankIds('top14'),d2=rankIds('prod2'),nat=rankIds('nationale');if(top.length&&d2.length)swapDivision(d2[0],top[top.length-1],'top14','prod2');if(d2.length&&nat.length)swapDivision(nat[0],d2[d2.length-1],'prod2','nationale');
 state.save.clubs.forEach(cl=>cl.players.forEach(p=>{p.age=(p.age||25)+1;p.seasonApps=0;p.seasonStarts=0;p.morale=clamp((p.morale||75)+2,45,95);p.fitness=clamp((p.fitness||90)+6,75,100)}));state.save.ops.academy.players.forEach(p=>p.age++);state.save.ops.academy.players.push(...academyIntake(c,6));
 const nc=userClub();nc.board=recalcBoard(nc);nc.transferBudget=Math.round(Math.max(nc.transferBudget||0,nc.budget*.055));nc.cash+=Math.round((nc.sponsor||0)*.12);state.save.competition=nc.comp;state.save.schedule=generateSchedule(nc.comp,state.save.clubs);state.save.table=blankTable(nc.comp,state.save.clubs);state.save.round=1;state.save.date=`${oldYear}-08-24`;state.save.history=[];state.save.lineup=null;state.save.bench=null;state.save.ops.board={confidence:65,history:[],warnings:0};state.save.ops.processedRounds=[];state.save.ops.seasons.push({year:oldYear+1,club:nc.id,comp:nc.comp});if(state.save.mgmt){state.save.mgmt.endSeasonProcessed=false;state.save.mgmt.processedRounds=[]}state.save.inbox.unshift({title:'Nouvelle saison',body:`Bienvenue en ${DB.comps[nc.comp]?.name||nc.comp}. Objectif : ${nc.board}.`,type:'board'});repairLineup();saveLocal();state.tab='home';render();toast('Nouvelle saison lancée')
}
