function processClubWeek(){initOps();const o=state.save.ops,r=state.save.round||1;if(o.processedRounds.includes(r))return;o.processedRounds.push(r);o.processedRounds=o.processedRounds.slice(-60);updateApps();trainingWeek();injuryWeek();moraleWeek();scoutingWeek();academyWeek();cashFlowWeek();boardWeek();saveLocal()}
function staffView(){const o=state.save.ops,c=userClub();return `${opsHeader('staff')}<div class="ops-section-title"><div><h3>Staff professionnel</h3><p>Qualité du staff : entraînement ${Math.round(trainingBoost()*100)} · médical ${Math.round(medBoost()*100)} · scouting ${Math.round(scoutBoost()*100)}</p></div><button class="btn secondary" onclick="refreshStaffMarket()">Actualiser le marché</button></div><div class="ops-staff-grid">${Object.entries(roleLabels).map(([role,label])=>{const s=o.staff[role];return `<div class="ops-staff-card"><span>${label}</span><h3>${X(s.first)} ${X(s.last)}</h3><div class="ops-rating"><b>${s.quality}</b><i><em style="width:${s.quality}%"></em></i></div><p>${X(s.specialty)} · ${euro(s.salary)}/mois · contrat ${s.contract}</p><button onclick="openStaffMarket('${role}')">Changer</button></div>`}).join('')}</div>`}
function refreshStaffMarket(){const c=userClub(),cost=25000;if(c.cash<cost)return toast('Trésorerie insuffisante');c.cash-=cost;state.save.ops.staffCandidates=createCandidates(c).map((s,i)=>({...s,quality:clamp(s.quality+(i%3)-1,40,96)}));saveLocal();render();toast('Marché du staff actualisé')}
function openStaffMarket(role){const o=state.save.ops,cur=o.staff[role],cand=o.staffCandidates.filter(x=>x.role===role).sort((a,b)=>b.quality-a.quality);modal15(`<div class="ops-modal-head"><div><span>MARCHÉ DU STAFF</span><h2>${roleLabels[role]}</h2><p>Actuel : ${X(cur.first)} ${X(cur.last)} · ${cur.quality}/100</p></div><button onclick="closeOpsModal()">✕</button></div><div class="ops-candidate-list">${cand.map(s=>`<div><div><b>${X(s.first)} ${X(s.last)}</b><small>${X(s.specialty)} · Qualité ${s.quality} · ${euro(s.salary)}/mois</small></div><button onclick="hireStaff('${role}','${s.id}')">Recruter</button></div>`).join('')}</div>`) }
function hireStaff(role,id){const o=state.save.ops,c=userClub(),s=o.staffCandidates.find(x=>x.id===id);if(!s)return;const old=o.staff[role],comp=Math.round((old?.salary||0)*2),bonus=Math.round(s.salary*2),cost=comp+bonus;if(c.cash<cost)return toast(`Il faut ${euro(cost)} de trésorerie.`);c.cash-=cost;o.staff[role]={...s};o.staffCandidates=o.staffCandidates.filter(x=>x.id!==id);o.financeLedger.unshift({round:state.save.round,type:'staff',net:-cost,text:`Recrutement ${s.first} ${s.last}`});state.save.inbox.push({title:'Staff',body:`${s.first} ${s.last} rejoint le club comme ${roleLabels[role]}.`,type:'staff'});saveLocal();closeOpsModal();render();toast('Staff recruté')}
function launchScoutMission(){const o=state.save.ops,c=userClub(),region=document.getElementById('sc-region').value,pos=document.getElementById('sc-pos').value,age=document.getElementById('sc-age').value,duration=region==='France'?2:region==='International'?4:3,cost=region==='France'?12000:28000;if(c.cash<cost)return toast('Trésorerie insuffisante');c.cash-=cost;o.scouting.missions.unshift({id:'mission-'+o.scouting.missionNo++,region,pos,age,duration,remaining:duration,status:'active',cost,startRound:state.save.round});saveLocal();render();toast('Mission de scouting lancée')}
function scoutingView(){const o=state.save.ops;return `${opsHeader('scouting')}<div class="ops-scout-top"><div class="ops-card"><h3>Nouvelle mission</h3><div class="ops-grid3"><label>Zone<select id="sc-region"><option>France</option><option>Îles britanniques</option><option>Océanie</option><option>Afrique</option><option>Amérique du Sud</option><option>International</option></select></label><label>Poste<select id="sc-pos"><option>ALL</option>${POSITIONS.map(x=>`<option>${x}</option>`).join('')}</select></label><label>Âge<select id="sc-age"><option>Tous</option><option>U23</option><option>24-28</option><option>29+</option></select></label></div><button class="btn" onclick="launchScoutMission()">Lancer la mission</button></div><div class="ops-card"><h3>Cellule recrutement</h3><div class="ops-metric"><span>Responsable</span><b>${staffQ('scout')}/100</b></div><div class="ops-metric"><span>Infrastructure</span><b>${facility('scouting')}/10</b></div><div class="ops-metric"><span>Précision estimée</span><b>${Math.round(scoutBoost()*100)}%</b></div></div></div><div class="ops-section-title"><div><h3>Missions en cours</h3><p>${o.scouting.missions.filter(x=>x.status==='active').length} active(s)</p></div></div>${o.scouting.missions.length?`<div class="ops-missions">${o.scouting.missions.slice(0,10).map(m=>`<div><span class="ops-chip ${m.status==='done'?'good':'warn'}">${m.status==='done'?'TERMINÉE':`${m.remaining} sem.`}</span><b>${X(m.region)}</b><small>${m.pos} · ${m.age} · coût ${euro(m.cost)}</small></div>`).join('')}</div>`:'<div class="ops-empty">Aucune mission.</div>'}<div class="ops-section-title"><div><h3>Rapports récents</h3><p>Les fourchettes se resserrent avec la qualité du recrutement.</p></div></div>${o.scouting.reports.length?`<div class="ops-report-grid">${o.scouting.reports.slice(0,24).map(reportCard).join('')}</div>`:'<div class="ops-empty">Lance une mission pour découvrir des profils.</div>'}`}
function reportCard(r){const c=club(r.clubId),p=c?.players.find(x=>x.id===r.playerId);if(!p)return'';return `<button class="ops-report" onclick="openScoutReport('${r.id}')"><span>${X(c.short)} · ${p.pos}</span><h3>${X(p.first)} ${X(p.last)}</h3><p>${p.age} ans · ${X(p.nat)}</p><div><b>Niv. ${r.caMin}-${r.caMax}</b><b>Pot. ${r.potMin}-${r.potMax}</b></div><small>Confiance ${r.confidence}%</small></button>`}
function openScoutReport(id){const r=state.save.ops.scouting.reports.find(x=>x.id===id);if(!r)return;const c=club(r.clubId),p=c?.players.find(x=>x.id===r.playerId);if(!p)return;modal15(`<div class="ops-modal-head"><div><span>RAPPORT RECRUTEMENT</span><h2>${X(p.first)} ${X(p.last)}</h2><p>${X(c.name)} · ${p.pos} · ${p.age} ans · ${X(p.nat)}</p></div><button onclick="closeOpsModal()">✕</button></div><div class="ops-report-detail"><div><small>Niveau estimé</small><b>${r.caMin} — ${r.caMax}</b></div><div><small>Potentiel estimé</small><b>${r.potMin} — ${r.potMax}</b></div><div><small>Confiance</small><b>${r.confidence}%</b></div><div><small>Contrat</small><b>${p.contract}</b></div></div><div class="ops-actions"><button class="btn" onclick="closeOpsModal();window.openTransfer('${c.id}','${p.id}')">Négocier</button><button class="btn secondary" onclick="window.shortlistToggle('${p.id}');closeOpsModal()">Shortlist</button></div>`) }
