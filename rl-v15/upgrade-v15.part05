const baseDashboard15=dashboardView;dashboardView=function(){initOps();const c=userClub(),o=state.save.ops,next=currentFixture(),rank=typeof getRank==='function'?getRank(c.id):'-',messages=state.save.inbox.slice(-4).reverse(),inj=c.players.filter(p=>p.injury?.weeks>0),active=o.scouting.missions.filter(x=>x.status==='active');return `<div class="dashboard-head"><div><div class="kicker">${DB.comps[c.comp].name} · J${state.save.round}</div><h1>${X(c.name)}</h1><p>${X(c.city)} · objectif ${X(c.board)}</p></div><div class="crest">${X(c.short)}</div></div><div class="grid four" style="margin-top:16px"><div class="card"><div class="meta">Classement</div><div class="stat">${rank}<small>e</small></div></div><div class="card"><div class="meta">Confiance direction</div><div class="stat">${Math.round(o.board.confidence)}%</div></div><div class="card"><div class="meta">Infirmerie</div><div class="stat">${inj.length}</div></div><div class="card"><div class="meta">Trésorerie</div><div class="stat" style="font-size:20px">${euro(c.cash)}</div></div></div>${next?`<div class="section-title"><h2>Prochain match</h2><p>Journée ${state.save.round}</p></div><div class="card"><div class="fixture"><div><div class="team">${club(next.home).short}</div><div class="when">${club(next.home).name}</div></div><div><div class="score">VS</div><button class="btn" onclick="openCurrentMatch()">Préparer</button></div><div><div class="team">${club(next.away).short}</div><div class="when">${club(next.away).name}</div></div></div></div>`:`<div class="ops-season-mini"><b>Saison terminée</b><span>La direction attend ton bilan.</span><button class="btn" onclick="state.tab='club';state.save.ops.tab='board';render()">Bilan & saison suivante</button></div>`}<div class="ops-dash-grid"><div class="card"><h3>Plan de travail</h3><div class="row"><span>${X(o.training.focus)}</span><b>${X(o.training.intensity)}</b></div><div class="row"><span>Coaching</span><b>${Math.round(trainingBoost()*100)}%</b></div><button class="btn secondary" onclick="state.tab='club';state.save.ops.tab='training';render()">Gérer</button></div><div class="card"><h3>Alertes sportives</h3>${inj.slice(0,3).map(p=>`<div class="row"><span>${X(p.last)} · ${X(p.injury.type)}</span><b>${p.injury.weeks} sem.</b></div>`).join('')||'<div class="meta">Effectif disponible.</div>'}${active.slice(0,2).map(m=>`<div class="row"><span>Scout ${X(m.region)}</span><b>${m.remaining} sem.</b></div>`).join('')}</div><div class="card"><h3>Boîte de réception</h3>${messages.map(m=>`<div class="row"><div><strong>${X(m.title)}</strong><div class="meta">${X(m.body)}</div></div></div>`).join('')}</div></div>`}
const previousClub15=clubView;clubView=function(){initOps();return clubOperationsView()};
const previousCommit15=commitMatch;commitMatch=function(){previousCommit15();if(state.save){initOps();processClubWeek();saveLocal();render()}};
const previousContinue15=continueCareer;continueCareer=function(){previousContinue15();if(state.save){initOps();repairLineup();saveLocal();render()}};
const previousStart15=startClub;startClub=function(id){previousStart15(id);if(state.save){initOps();repairLineup();saveLocal();render()}};
const previousCustom15=buildCustomClub;buildCustomClub=function(){previousCustom15();if(state.save){initOps();repairLineup();saveLocal();render()}};
const previousOpenMatch15=openCurrentMatch;openCurrentMatch=function(){initOps();repairLineup();const unavailable=(state.save.lineup||[]).some(id=>{const p=userClub().players.find(x=>x.id===id);return p&&!available(p)});if(unavailable)return toast('La composition contient un joueur indisponible.');previousOpenMatch15()};
const previousSetXV15=window.setXV;if(previousSetXV15)window.setXV=function(slot,id){const p=userClub().players.find(x=>x.id===id);if(p?.injury?.weeks>0)return toast(`${p.last} est indisponible encore ${p.injury.weeks} sem.`);previousSetXV15(slot,id)};
Object.assign(window,{setOpsTab,refreshStaffMarket,openStaffMarket,hireStaff,launchScoutMission,openScoutReport,academyTrialDay,promoteYouth,releaseYouth,saveTrainingPlan,setIndividualTraining,infraUpgrade,advanceSeason15,closeOpsModal});
if(state.save){initOps();repairLineup();saveLocal()}
})();
