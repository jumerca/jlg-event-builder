 const c=userClub();if(!state.save.lineup)return;const used=new Set(),current=[...state.save.lineup];for(let i=0;i<current.length;i++){let p=c.players.find(x=>x.id===current[i]);if(p&&available(p)&&!used.has(p.id)){used.add(p.id);continue}let rep=c.players.filter(x=>available(x)&&!used.has(x.id)).sort((a,b)=>(b.ca+(b.fitness||90)*.1)-(a.ca+(a.fitness||90)*.1))[0];if(rep){current[i]=rep.id;used.add(rep.id)}}state.save.lineup=current;state.save.bench=c.players.filter(p=>available(p)&&!used.has(p.id)).sort((a,b)=>b.ca-a.ca).slice(0,8).map(p=>p.id)
}
function updateApps(){const c=userClub(),line=new Set(state.save.lineup||[]),bench=new Set(state.save.bench||[]);c.players.forEach(p=>{if(line.has(p.id)){p.seasonStarts++;p.seasonApps++}else if(bench.has(p.id)&&Math.random()<.58)p.seasonApps++})}
function developPlayer(p,focus,intensityMul,coachMul){
 if(p.injury?.weeks>0)return;const age=p.age||26;let ageMul=age<=21?1.6:age<=24?1.28:age<=28?.82:age<=31?.38:-.20;let gain=.035*ageMul*intensityMul*(.7+coachMul);if((p.ca||0)>=(p.potential||p.ca))gain=Math.min(0,gain);p.devProgress=(p.devProgress||0)+gain;
 const keys=TRAINING[focus]||TRAINING['Équilibré'];if(gain>0&&keys.length&&Math.random()<.10*intensityMul){const k=keys[hash(p.id+state.save.round)%keys.length];if(p.attrs?.[k]!=null)p.attrs[k]=Math.min(20,p.attrs[k]+1)}
 while(p.devProgress>=1&&p.ca<p.potential){p.devProgress-=1;p.ca++;state.save.ops.development.unshift({round:state.save.round,playerId:p.id,text:`${p.first} ${p.last} progresse à ${p.ca}`})}
 while(p.devProgress<=-1&&p.ca>45){p.devProgress+=1;p.ca--;state.save.ops.development.unshift({round:state.save.round,playerId:p.id,text:`${p.first} ${p.last} régresse à ${p.ca}`})}
}
function trainingWeek(){const o=state.save.ops,c=userClub(),plan=o.training,intensity=plan.intensity==='Élevée'?1.34:plan.intensity==='Légère'?.72:1,coach=trainingBoost();c.players.forEach(p=>{const f=plan.individual[p.id]||plan.focus;developPlayer(p,f,intensity,coach);const recovery=f==='Récupération'?5:plan.intensity==='Légère'?3:plan.intensity==='Élevée'?-1:1;p.fitness=clamp((p.fitness||90)+recovery,45,100)});o.academy.players.forEach(p=>developPlayer(p,plan.individual[p.id]||plan.focus,intensity*.9,academyBoost()))}
function injuryWeek(){
 const o=state.save.ops,c=userClub(),med=medBoost();c.players.forEach(p=>{if(p.injury?.weeks>0){p.injury.weeks--;if(p.injury.weeks<=0){o.medical.history.unshift({...p.injury,playerId:p.id,returnedRound:state.save.round});p.injury=null;p.fitness=Math.max(p.fitness,72);state.save.inbox.push({title:'Retour médical',body:`${p.first} ${p.last} est de nouveau disponible.`,type:'medical'})}return}
 const intensity=o.training.intensity==='Élevée'?1.55:o.training.intensity==='Légère'?.68:1,selected=(state.save.lineup||[]).includes(p.id)||(state.save.bench||[]).includes(p.id),fatigue=clamp((82-(p.fitness||90))/80,0,.18),age=(p.age||26)>31?.004:0,chance=(selected?.009:.0035)*intensity*(1-med*.45)+fatigue+age;if(Math.random()<chance){const it=INJURIES[hash(p.id+state.save.round)%INJURIES.length],raw=it[1]+Math.floor(Math.random()*(it[2]-it[1]+1)),weeks=Math.max(1,Math.round(raw*(1-med*.28)));p.injury={type:it[0],weeks,totalWeeks:weeks,startRound:state.save.round};p.fitness=Math.min(p.fitness,60);o.medical.injuries.unshift({playerId:p.id,type:it[0],weeks,startRound:state.save.round});state.save.inbox.push({title:'Infirmerie',body:`${p.first} ${p.last} : ${it[0]} — indisponible environ ${weeks} semaine(s).`,type:'medical'})}});repairLineup()
}
function moraleWeek(){const c=userClub(),r=Math.max(1,state.save.round-1);c.players.forEach(p=>{const rate=(p.seasonStarts||0)/r,expect=p.role==='Cadre'?.72:p.role==='Rotation importante'?.48:p.role==='Rotation'?.28:.12;let d=rate>=expect?1:rate<expect*.55?-2:0;if(p.injury?.weeks>0)d-=1;p.morale=clamp((p.morale||75)+d,35,100)})}
function cashFlowWeek(){const c=userClub(),o=state.save.ops,round=Math.max(1,state.save.round-1);let sponsor=(c.sponsor||0)/26,wages=playerPayroll(c)/26,staff=staffPayroll()/26,gate=0,last=state.save.history[state.save.history.length-1];if(last&&last.round===round&&last.home===c.id){const attendance=Math.round(Math.min(c.stadium,c.fans*(.82+((round%5)*.025))));gate=attendance*(c.ticket||25)}const net=sponsor+gate-wages-staff;c.cash=(c.cash||0)+net;o.financeLedger.unshift({round,type:'week',sponsor,gate,wages,staff,net,cash:c.cash});o.financeLedger=o.financeLedger.slice(0,80);if(c.cash<0)state.save.inbox.push({title:'Alerte trésorerie',body:`La trésorerie est négative (${euro(c.cash)}). La direction demande un plan de redressement.`,type:'finance'})}
function targetRank(c){if(c.board==='Titre')return 2;if(c.board==='Phases finales')return 6;if(c.board==='Montée')return 2;if(c.board==='Top 6')return 6;if(c.board==='Maintien')return c.comp==='top14'?11:12;return 9}
function boardWeek(){const c=userClub(),o=state.save.ops,b=o.board,rank=typeof getRank==='function'?getRank(c.id):8,target=targetRank(c),mor=avg(c.players,p=>p.morale||75),inj=c.players.filter(p=>p.injury?.weeks>0).length;let d=rank<=target?1:rank>target+3?-2:-.5;if(c.cash<0)d-=2;if(mor<60)d-=1;if(inj>=7)d-=1;b.confidence=clamp(Math.round((b.confidence+d)*10)/10,15,100);b.history.unshift({round:state.save.round,confidence:b.confidence,rank});b.history=b.history.slice(0,40);if(b.confidence<35&&b.warnings<2){b.warnings++;state.save.inbox.push({title:'Pression de la direction',body:`Confiance : ${Math.round(b.confidence)}%. Les résultats doivent rapidement s’améliorer.`,type:'board'})}}
function regionMatch(nat,region){if(region==='France')return nat==='France';if(region==='Îles britanniques')return ['Angleterre','Écosse','Irlande','Pays de Galles'].includes(nat);if(region==='Océanie')return ['Nouvelle-Zélande','Australie','Fidji','Samoa','Tonga'].includes(nat);if(region==='Afrique')return ['Afrique du Sud','Géorgie'].includes(nat);if(region==='Amérique du Sud')return ['Argentine'].includes(nat);return true}
function completeMission(m){const o=state.save.ops,quality=scoutBoost(),pool=[];state.save.clubs.forEach(c=>{if(c.id===state.save.clubId)return;c.players.forEach(p=>{if(m.pos!=='ALL'&&p.pos!==m.pos)return;if(m.age==='U23'&&p.age>23)return;if(m.age==='24-28'&&(p.age<24||p.age>28))return;if(m.age==='29+'&&p.age<29)return;if(!regionMatch(p.nat,m.region))return;pool.push({p,c})})});pool.sort((a,b)=>(b.p.potential+b.p.ca*.5)-(a.p.potential+a.p.ca*.5));const count=clamp(3+Math.round(quality*5),4,8),err=Math.max(1,Math.round(7-quality*4));pool.slice(0,count).forEach(({p,c})=>{if(o.scouting.reports.some(x=>x.playerId===p.id))return;o.scouting.reports.unshift({id:'rep'+p.id+state.save.round,playerId:p.id,clubId:c.id,seenRound:state.save.round,confidence:clamp(Math.round(55+quality*42),58,96),caMin:Math.max(40,p.ca-err),caMax:Math.min(99,p.ca+err),potMin:Math.max(p.ca,p.potential-err),potMax:Math.min(99,p.potential+err)})});m.status='done';state.save.inbox.push({title:'Rapport de recrutement',body:`Mission ${m.region} terminée : ${count} profil(s) analysé(s).`,type:'scouting'})}
function scoutingWeek(){const missions=state.save.ops.scouting.missions;missions.filter(m=>m.status==='active').forEach(m=>{m.remaining--;if(m.remaining<=0)completeMission(m)})}
function academyWeek(){const a=state.save.ops.academy,boost=academyBoost();a.players.forEach(p=>{p.morale=clamp(p.morale+(Math.random()<.5?1:0),55,100);if(Math.random()<.04*boost&&p.ca<p.potential){p.ca++;p.devProgress=0}})}
